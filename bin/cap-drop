#!/usr/bin/env bash
# cap-drop - remove a task without losing work.

. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap drop <slug> [--force] [--take]"


parse_args() {
	slug=""
	force=0
	take=0

	while [ $# -gt 0 ]; do
		case $1 in
		--force)
			force=1
			shift
			;;
		--take)
			take=1
			shift
			;;
		-*)
			die "$usage"
			;;
		*)
			[ -z "$slug" ] || die "$usage"
			slug=$1
			shift
			;;
		esac
	done

	[ -n "$slug" ] || die "$usage"
}


check_clean_tree() {
	dirty=$(git_dirty "$CAP_TREE")

	[ "$dirty" = 0 ] ||
		die "refusing: $dirty uncommitted change(s) in $CAP_TREE (--force to discard)"
}


check_no_children() {
	kids=$(task_children "$slug" | tr '\n' ' ')

	[ -z "$kids" ] ||
		die \
			"refusing: ${kids% } stacked on $slug; the branch survives the drop but the record does not, so cap land $slug --merge could never restack them (--force to drop anyway)"
}


check_scout_report() {
	[ -s "$CAP_HOME/notes/$CAP_PROJECT/$slug.md" ] ||
		die "refusing: scout has no report yet (--force to discard)"
}


branch_landed() {
	pr=$(task_field "$slug" CAP_PR)
	local merged_branches

	# Squash merges do not contain the task branch commit, so git cannot detect
	# them with branch --contains. Check the PR when one was recorded.
	if [ -n "$pr" ] && have gh; then
		[ "$(gh pr view "$pr" --json state -q .state 2>/dev/null)" = MERGED ] && return 0
	fi

	merged_branches=$(git -C "$CAP_REPO" branch --contains "$CAP_BRANCH" --merged 2>/dev/null | grep -c . || true)
	[ "$merged_branches" -gt 0 ]
}


branch_pushed() {
	git -C "$CAP_TREE" rev-parse --verify "origin/$CAP_BRANCH" >/dev/null 2>&1
}


check_branch_work() {
	commits=$(git -C "$CAP_TREE" rev-list --count "$CAP_BASE..HEAD" 2>/dev/null || echo 0)

	[ "$commits" = 0 ] && return
	branch_landed && return
	branch_pushed && return

	die "refusing: $commits commit(s) on $CAP_BRANCH are neither merged nor pushed (--force to discard)"
}


check_safe_to_drop() {
	check_clean_tree
	check_no_children

	if [ "$CAP_KIND" = scout ]; then
		check_scout_report
		return
	fi

	check_branch_work
}


parse_args "$@"

task_load "$slug"
task_lock "$slug"

if [ "$take" = 1 ]; then
	task_owner_take "$slug"
else
	task_owner_claim "$slug"
fi

if [ "$force" = 0 ]; then
	check_safe_to_drop
fi

pane_live "$slug" && pane_kill "$slug"

compose_down "$CAP_TREE" ||
	die "could not stop $slug's dev stack; worktree kept at $CAP_TREE"

git -C "$CAP_REPO" worktree remove --force "$CAP_TREE" 2>/dev/null ||
	rm -rf "$CAP_TREE"

git -C "$CAP_REPO" worktree prune
rm -rf "$(task_dir "$slug")"

printf 'dropped %s (branch %s kept in %s)\n' "$slug" "$CAP_BRANCH" "$CAP_REPO"
