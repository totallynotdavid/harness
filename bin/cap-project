#!/usr/bin/env bash
# cap-project - show or change project settings.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

name=${1:-}

if [ -z "$name" ]; then
	printf 'PROJECT\tREMOTE\tMODE\tMODEL\n'
	cat "$PROJECTS" 2>/dev/null
	exit 0
fi

mode=${2:-}
model=${3:-}

if [ -z "$mode" ]; then
	printf '%s\t%s\t%s\t%s\n' \
		"$name" \
		"$(proj_path "$name")" \
		"$(proj_mode "$name")" \
		"$(proj_model "$name")"
	exit 0
fi

case $mode in
pr | local | scout | ignore) ;;
*) die "mode must be pr|local|scout|ignore" ;;
esac

if [ -z "$model" ]; then
	model=$(proj_model "$name")
fi

model=${model:--}

tmp=$(mktemp)

if ! awk -F'\t' -v OFS='\t' -v name="$name" -v mode="$mode" -v model="$model" \
	'$1 == name { $3 = mode; $4 = model } { print }' \
	"$PROJECTS" >"$tmp"; then
	rm -f "$tmp"
	die "failed to update project"
fi

mv "$tmp" "$PROJECTS"

printf '%s -> mode=%s model=%s\n' "$name" "$mode" "$model"
