#!/usr/bin/env bash
# cap-models - show available models and validate configured profiles.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

if [ "${1:-}" = --refresh ]; then
  rm -f "$CAP_USAGE_DIR/codex-models.json"
  shift
fi

rows=$(printf '%s\n' "$CAP_ASK_PROFILES" |
  awk 'NF {print $1, $2, $3, ($4 == "" ? "-" : $4)}')

print_codex_models() {
  local catalog

  if ! catalog=$(codex_catalog); then
    warn "the codex app-server did not answer; codex profiles are unchecked"
    return
  fi

  [ -n "$catalog" ] || return 0

  printf 'CODEX MODELS\n'
  {
    printf 'MODEL\tDEFAULT\tACCEPTS\tPROFILE\n'
    printf '%s' "$catalog" | jq -r --arg rows "$rows" '
      ($rows | split("\n") | map(split(" ")) | map(select(length == 4))) as $p
      | (.data // [])[]
      | . as $m
      | ($p | map(select(.[1] == "codex" and .[2] == $m.model)) | map(.[0]) | join(",")) as $claimed
      | [$m.model,
         ($m.defaultReasoningEffort // "-"),
         ((.supportedReasoningEfforts // []) | map(.reasoningEffort) | join(" ")),
         (if $claimed == "" then "-" else $claimed end)]
      | @tsv'
  } | column -t -s $'\t' | sed 's/^/  /'
  printf '\n'
}

print_claude_models() {
  local seen

  printf 'CLAUDE MODELS\n'

  # Claude has no catalog request. Report models observed from real sessions.
  printf '  no catalog request exists; aliases resolve at session start\n'

  if usage_files; then
    seen=$(jq -rs '
      map(select((.harness // "claude") == "claude" and (.model_id // "") != ""))
      | group_by(.model_id)
      | map(max_by(.at))
      | sort_by(.at)
      | reverse
      | map([.model_id, "seen \((now - .at) / 3600 | floor)h ago as \(.model)"] | @tsv)
      | join("\n")
    ' "$CAP_USAGE_DIR"/*.json 2>/dev/null || true)

    if [ -n "$seen" ]; then
      printf '%s\n' "$seen" | column -t -s $'\t' | sed 's/^/  /'
    fi
  fi

  printf '\n'
}

print_profiles() {
  local report=""
  local bad=0
  local name harness model effort problem status

  while read -r name harness model effort; do
    if problem=$(profile_check "$name"); then
      status=ok
    else
      status=$problem
      bad=1
    fi

    report+=$(printf '%s\t%s\t%s\t%s\t%s' \
      "$name" "$harness" "$model" "$effort" "$status")$'\n'
  done <<<"$rows"

  printf 'PROFILES\n'
  {
    printf 'PROFILE\tHARNESS\tMODEL\tEFFORT\tSTATUS\n'
    printf '%s' "$report"
  } | column -t -s $'\t' | sed 's/^/  /'

  return "$bad"
}

print_codex_models
print_claude_models

if ! print_profiles; then
  printf '\n'
  warn "a profile names something its harness does not offer; fix config/captain.conf"
  exit 1
fi
