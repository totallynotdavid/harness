#!/usr/bin/env bash
# cap-explore - manage cloned repos for inspection.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

EXPLORE="$CAP_HOME/state/explore"

usage() {
  cat <<'EOF'
cap explore <owner/repo|url> [--fresh]   clone a repo and print its path
cap explore --list                       list cloned repos
cap explore --rm <slug>                  remove a cloned repo
EOF
}

repo_slug() {
  local spec=${1%.git}
  local name
  local owner

  name=${spec##*/}
  owner=${spec%/"$name"}
  owner=${owner##*/}

  printf '%s-%s' "$owner" "$name"
}

repo_url() {
  case $1 in
    http://*|https://*|git@*)
      printf '%s' "$1"
      ;;
    *)
      printf 'https://github.com/%s' "$1"
      ;;
  esac
}

touch_repo() {
  now > "$1/.cap-touched"
}

case ${1:-} in
  --list)
    if [ ! -d "$EXPLORE" ]; then
      echo "nothing explored yet"
      exit 0
    fi

    found=0

    for dir in "$EXPLORE"/*/; do
      [ -d "$dir/.git" ] || continue

      found=1
      touched=$(cat "$dir/.cap-touched" 2>/dev/null || echo 0)
      age=$((($(now) - touched) / 3600))

      printf '%-30s %sh since last use  %s\n' \
        "$(basename "$dir")" \
        "$age" \
        "${dir%/}"
    done

    if [ "$found" -eq 0 ]; then
      echo "nothing explored yet"
    fi

    exit 0
    ;;

  --rm)
    slug=${2:?usage: cap explore --rm <slug>}

    case $slug in
      */*|..*)
        die "bad slug '$slug'"
        ;;
    esac

    [ -d "$EXPLORE/$slug" ] || die "no explored repo '$slug'"

    rm -rf "${EXPLORE:?}/$slug"
    printf 'removed %s\n' "$slug"
    exit 0
    ;;

  -h|--help|"")
    usage
    exit 0
    ;;
esac

spec=$1
shift

fresh=0
if [ "${1:-}" = "--fresh" ]; then
  fresh=1
fi

slug=$(repo_slug "$spec")
dir="$EXPLORE/$slug"

mkdir -p "$EXPLORE"

if [ "$fresh" -eq 1 ]; then
  rm -rf "$dir"
fi

if [ ! -d "$dir/.git" ]; then
  git clone --depth 1 "$(repo_url "$spec")" "$dir" >/dev/null 2>&1 ||
    die "clone of $spec failed"
fi

touch_repo "$dir"
printf '%s\n' "$dir"
