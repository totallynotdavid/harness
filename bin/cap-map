#!/usr/bin/env bash
# cap-map - rebuild the project map and optionally add new projects.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

sync=0
if [ "${1:-}" = "--sync" ]; then
	sync=1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

cap_scan_roots >"$tmp"

if [ "$sync" = 1 ]; then
	touch "$PROJECTS"
	added=0
	skipped=0

	while IFS=$'\t' read -r name _path remote; do
		awk -F'\t' -v name="$name" '$1 == name { found = 1 } END { exit !found }' "$PROJECTS" &&
			continue

		if [ -z "$remote" ]; then
			skipped=$((skipped + 1))
			continue
		fi

		printf '%s\t%s\t%s\t%s\n' "$name" "$remote" pr - >>"$PROJECTS"
		added=$((added + 1))
	done <"$tmp"

	sort -o "$PROJECTS" "$PROJECTS"
	local_index_rebuild

	printf 'registered %s new project(s)' "$added"
	[ "$skipped" = 0 ] || printf ', skipped %s with no origin remote' "$skipped"
	printf '\n'
fi

{
	printf '# Map\n\n'
	printf 'Generated by `cap map`. Registered projects include a delivery mode. Other repos are only on disk.\n\n'
	printf '| project | path | branch | dirty | last commit | mode |\n'
	printf '|---|---|---|---|---|---|\n'

	while IFS=$'\t' read -r name path _remote; do
		mode=$(awk -F'\t' -v name="$name" '$1 == name { print $3 }' "$PROJECTS" 2>/dev/null)
		last_commit=$(git -C "$path" log -1 --format=%cs 2>/dev/null || echo '-')
		display_path=$(printf '%s' "$path" | sed "s|^$HOME|~|")

		printf '| %s | %s | %s | %s | %s | %s |\n' \
			"$name" \
			"$display_path" \
			"$(git_branch "$path")" \
			"$(git_dirty "$path")" \
			"$last_commit" \
			"${mode:--}"
	done <"$tmp"
} >"$CAP_HOME/map.md"

printf 'map.md: %s repo(s)\n' "$(wc -l <"$tmp")"
