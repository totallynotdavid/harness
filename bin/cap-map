#!/usr/bin/env bash
# cap-map - rebuild the project map and optionally add new projects.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

sync=0
[ "${1:-}" = --sync ] && sync=1

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

IFS=: read -ra roots <<<"$CAP_ROOTS"

for root in "${roots[@]}"; do
	[ -d "$root" ] || continue

	for d in "$root"/*/; do
		[ -d "$d.git" ] || continue

		p=${d%/}
		n=$(basename "$p")
		[ "$p" = "$CAP_HOME" ] && continue

		printf '%s\t%s\n' "$n" "$p" >>"$tmp"
	done
done

if [ "$sync" = 1 ]; then
	touch "$PROJECTS"
	added=0

	while IFS=$'\t' read -r n p; do
		cut -f1 "$PROJECTS" | grep -qx "$n" && continue
		printf '%s\t%s\t%s\t%s\n' "$n" "$p" pr - >>"$PROJECTS"
		added=$((added + 1))
	done <"$tmp"

	sort -o "$PROJECTS" "$PROJECTS"
	printf 'registered %s new project(s)\n' "$added"
fi

{
	printf '# Map\n\nGenerated by `cap map`. Registered projects include a delivery mode. Other repos are only on disk.\n\n'
	printf '| project | path | branch | dirty | last commit | mode |\n|---|---|---|---|---|---|\n'

	while IFS=$'\t' read -r n p; do
		mode=$(awk -F'\t' -v n="$n" '$1==n{print $3}' "$PROJECTS" 2>/dev/null)
		last=$(git -C "$p" log -1 --format=%cs 2>/dev/null || echo '-')

		printf '| %s | %s | %s | %s | %s | %s |\n' \
			"$n" \
			"$(printf '%s' "$p" | sed "s|^$HOME|~|")" \
			"$(git_branch "$p")" \
			"$(git_dirty "$p")" \
			"$last" \
			"${mode:--}"
	done <"$tmp"
} >"$CAP_HOME/map.md"

printf 'map.md: %s repo(s)\n' "$(wc -l <"$tmp")"
