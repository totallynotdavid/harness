#!/usr/bin/env bash
# cap-send - send a message to a running agent.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

slug=${1:?usage: cap send <slug> [--force] "<text>"}
shift

force=0
[ "${1:-}" = --force ] && { force=1; shift; }

text=$*
[ -n "$text" ] || die "nothing to send"

# A dead pane used to end the command here, which left the captain holding
# work the agent should be doing: local-env's pane died mid-round and the
# correction meant for it had to be applied by hand. The task record still
# holds everything cap-spawn used to open the session in the first place, so
# bring it back rather than dropping the message.
#
# The revived session gets the instruction inside its opening prompt rather
# than as a second turn. Launching it on the contract alone and then sending
# would race a turn that has already started, and the pane would be busy
# exactly when the message arrived.
revive() {
  local dir=$TASKS/$slug kick margs=() scrub cmd
  task_load "$slug"
  [ -f "$dir/contract.md" ] || die "$slug: pane is not live and there is no contract to restart it from"

  kick="This session replaces one that died. You are still working on $slug in
this worktree, but the previous session's conversation is gone.

Read $dir/contract.md for the task, then $dir/status.log for what has already
been done and reported. Do not redo finished work.

Then carry out this instruction from the captain:

$text"

  if [ "$CAP_MODEL" != '-' ]; then margs=(--model "$CAP_MODEL"); fi
  scrub=(env "${CAP_ENV_SCRUB[@]}" "${CAP_CACHE_ENV[@]}" CAP_TASK="$slug")
  case $CAP_HARNESS in
    claude)
      if [ -n "${CAP_EFFORT:-}" ]; then margs+=(--effort "$CAP_EFFORT"); fi
      # shellcheck disable=SC2206 # CAP_AGENT_FLAGS is a flag string, split on purpose
      cmd=("${scrub[@]}" claude "${margs[@]}" $CAP_AGENT_FLAGS "$kick")
      ;;
    codex)
      if [ -n "${CAP_EFFORT:-}" ]; then margs+=(-c "model_reasoning_effort=$CAP_EFFORT"); fi
      cmd=("${scrub[@]}" codex "${margs[@]}"
           --dangerously-bypass-approvals-and-sandbox "$kick")
      ;;
    *) die "unknown harness '$CAP_HARNESS'" ;;
  esac

  require_herdr
  local pane tabid
  read -r pane tabid <<<"$(herdr_open "$CAP_TREE" "$slug")"
  pane_launch "$pane" "${cmd[@]}"
  task_env_set "$slug" CAP_PANE "$pane"
  task_env_set "$slug" CAP_TAB "$tabid"
  warn "$slug: pane was not live; restarted the session on $CAP_MODEL and delivered the message in its opening prompt"
}


deliver() {
	pane_send "$slug" "$text"
	for _ in 1 2 3; do
		sleep 0.4
		pane_enter "$slug"
		sleep 0.6
		# Stop retrying once the message has left the input box. Check the
		# END of the text, not the start: pane_tail returns the last N
		# lines of the pane, which for an unsubmitted multi-line message is
		# its tail, not its head. Anchoring on the first 40 chars made this
		# check pass (falsely, "it's gone") for any message longer than the
		# tail window, because the start had simply scrolled out of view
		# while the message sat there unsubmitted - found by hand against
		# relq-executor-ergonomics after wait_working correctly caught the
		# resulting no-turn-started failure twice in a row.
		pane_tail "$slug" 6 | grep -qF "${text: -40}" || break
	done
}

wait_working() {
		local i
	# shellcheck disable=SC2034 # a counted retry, the body does not read i
	for i in 1 2 3 4 5 6; do
		sleep 1
		[ "$(pane_agent_status "$slug")" = working ] && return 0
	done
	return 1
}

if ! pane_live "$slug"; then
	revive
	wait_working ||
		die "$slug: restarted the session but no turn began - check by hand: cap peek $slug"
	printf 'restarted %s and sent (working, fresh session)\n' "$slug"
	exit 0
fi

# A session near its limit is the failure that made aula-integrate report tests
# passing while seven files errored: it ran out of context mid-verification and
# summarised optimistically. So the ceiling is checked before delivering, not
# after, back when this printed an advisory *below* the `deliver` call the
# message was already in the agent's input box by the time the captain read it.
#
# The recovery is compaction, and cap-ask already does exactly this before it
# resumes a large session. Doing it here too keeps it off the captain's hands.
# The alternatives this replaces were both worse: --force fills the session the
# ceiling exists to protect, and cap drop throws away the worktree.
compact_pane() {
	local deadline waited=0 now
	warn "$slug: at $ctx% context; compacting before the message goes in"
	pane_send "$slug" "/compact"
	sleep 0.4
	pane_enter "$slug"
	wait_working || return 1

	# Wait on the context reading, not on the agent status. Compacting a full
	# session runs for minutes behind a progress bar, and the status line keeps
	# the pre-compaction percentage until the moment it finishes.
	deadline=${CAP_SEND_COMPACT_SECS:-600}
	while [ "$waited" -lt "$deadline" ]; do
		sleep 10
		waited=$((waited + 10))
		now=$(pane_context_pct "$slug")
		if [ -n "$now" ] && [ "$now" -lt "$CAP_SEND_CTX_MAX" ] 2>/dev/null; then
			ctx=$now
			return 0
		fi
	done
	return 1
}

ctx=$(pane_context_pct "$slug")
if [ "$force" = 0 ] && [ -n "$ctx" ] && [ "$ctx" -ge "$CAP_SEND_CTX_MAX" ] 2>/dev/null; then
	if compact_pane; then
		printf 'compacted %s to %s%% context\n' "$slug" "$ctx"
	else
		printf 'cap: %s is at %s%% context and compacting it did not bring it under %s%%.\n' \
			"$slug" "$(pane_context_pct "$slug")" "$CAP_SEND_CTX_MAX" >&2
		printf 'The live conversation is genuinely that large. Either finish the task\n' >&2
		printf '(cap check / cap commit / cap land), restart it clean (cap drop %s then\n' "$slug" >&2
		printf 'cap spawn with an updated brief), or send anyway:\n' >&2
		die "cap send $slug --force \"...\""
	fi
fi

deliver
started=0
wait_working && started=1

# A message leaving the input box only proves it was submitted, not that a
# turn began - this has happened for real: the text sat in the pane with no
# response and the agent read idle minutes later (see docs/pipeline-notes.md,
# "Gate A frequency" era investigation). Retry the whole delivery once before
# giving up, rather than reporting success on a guess.
if [ "$started" = 0 ]; then
	warn "$slug: no turn started after the first send; retrying once"
	deliver
	wait_working && started=1
fi

[ "$started" = 1 ] || die "$slug: sent twice but the agent never started a turn - check by hand: cap peek $slug"

# A turn has started, so the task is not done, and cap send is the one place
# that knows this for certain. The verb used to depend on the agent choosing
# to log `working:` itself, so cap crew reported done for a task mid-round and
# the reminder hook listed it as waiting to land. Record the fact here instead
# of inferring it from the screen.
printf 'working: sent by the captain: %s\n' "$(printf '%s' "${text%%$'\n'*}" | cut -c1-120)" \
	>>"$TASKS/$slug/status.log"

if [ "$force" = 1 ] && [ -n "$ctx" ]; then
	printf 'sent to %s (working, ctx %s%% used, forced past the ceiling)\n' "$slug" "$ctx"
else
	printf 'sent to %s (working, ctx %s%% used)\n' "$slug" "${ctx:-?}"
fi
