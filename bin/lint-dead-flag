#!/usr/bin/env bash
# lint-dead-flag - find a flag parsed into a variable nothing after the
# parsing loop reads. An accepted flag whose variable is never consulted
# again is accepted and silently dropped.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

mapfile -t files < <(grep -LE '^#!.*python' bin/cap bin/cap-* bin/lib.sh bin/lint-* bin/hooks/*.sh)

status=0
for f in "${files[@]}"; do
	# Every flag-arm assignment (a case label starting with `-`, never the
	# bare `*)` positional arm), paired with its own loop's closing line so
	# a file with two flag loops never checks a name against the wrong
	# loop's end. Matched past the label's own closing paren, not the
	# first "word=" on the line, so a label like `--base=*)` isn't read as
	# the arm's real variable.
	mapfile -t records < <(awk '
		/while \[ \$# -gt 0 \]/ { inloop = 1; flagarm = 0; n = 0; delete names; next }
		inloop && /^[ \t]*done[ \t;]*$/ {
			for (i = 1; i <= n; i++) print NR "\t" names[i]
			inloop = 0; next
		}
		inloop {
			if ($0 ~ /^[ \t]*-[^)]*\)/) flagarm = 1
			else if ($0 ~ /^[ \t]*\*\)/) flagarm = 0
			if (!flagarm) next
			line = $0
			paren = index(line, ")")
			if (paren > 0) line = substr(line, paren + 1)
			if (match(line, /([A-Za-z_][A-Za-z0-9_]*)=/, m)) { n++; names[n] = m[1] }
		}
	' "$f")
	pid=$!
	wait "$pid" || { printf '%s: could not scan for flag assignments\n' "$f" >&2; status=1; continue; }

	seen=""
	for record in "${records[@]}"; do
		end=${record%%$'\t'*}
		name=${record#*$'\t'}
		key="$end:$name"
		case $seen in *" $key "*) continue ;; esac
		seen="$seen $key "

		hits=$(tail -n "+$((end + 1))" "$f" | grep -cE "\\\$\\{?$name\\b" || true)
		[ "$hits" -gt 0 ] && continue
		printf '%s: %s is parsed as a flag but never read after the parsing loop\n' "$f" "$name" >&2
		status=1
	done
done

[ "$status" = 0 ] && printf 'lint-dead-flag: no flag parsed and never read\n'
exit "$status"
