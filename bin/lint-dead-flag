#!/usr/bin/env bash
# lint-dead-flag - find a flag parsed into a variable nothing after the
# parsing loop reads. An accepted flag whose variable is never consulted
# again is accepted and silently dropped.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

mapfile -t files < <(grep -LE '^#!.*python' bin/cap bin/cap-* bin/lib.sh bin/lint-* bin/hooks/*.sh)

status=0
for f in "${files[@]}"; do
	# Line range of every `while [ $# -gt 0 ]; do ... done` flag loop, and
	# the variables assigned inside a flag-labeled arm (a case label
	# starting with `-`), not the bare `*)` positional arm.
	mapfile -t names < <(awk '
		/while \[ \$# -gt 0 \]/ { inloop = 1; flagarm = 0; next }
		inloop && /^[ \t]*done[ \t;]*$/ { inloop = 0; next }
		inloop {
			if ($0 ~ /^[ \t]*-[^)]*\)/) flagarm = 1
			else if ($0 ~ /^[ \t]*\*\)/) flagarm = 0
			if (flagarm && match($0, /([A-Za-z_][A-Za-z0-9_]*)=/, m)) print m[1]
		}
	' "$f" | sort -u)

	for name in "${names[@]}"; do
		[ -n "$name" ] || continue
		hits=$(grep -cE "\\\$\\{?$name\\b" "$f" || true)
		[ "$hits" -gt 0 ] && continue
		printf '%s: %s is parsed as a flag but never read\n' "$f" "$name" >&2
		status=1
	done
done

[ "$status" = 0 ] && printf 'lint-dead-flag: no flag parsed and never read\n'
exit "$status"
