#!/usr/bin/env bash
# lint-dead-flag - find a flag parsed into a variable nothing after the
# parsing loop reads. An accepted flag whose variable is never consulted
# again is accepted and silently dropped.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

mapfile -t files < <(grep -LE '^#!.*python' bin/cap bin/cap-* bin/lib.sh bin/lint-* bin/hooks/*.sh)

status=0
for f in "${files[@]}"; do
	# The line range of every `while [ $# -gt 0 ]; do ... done` flag loop,
	# and the variables assigned inside a flag-labeled arm (a case label
	# starting with `-`, not the bare `*)` positional arm). One record per
	# line: "END <n>" for the loop's closing line, "NAME <var>" per flag.
	mapfile -t records < <(awk '
		/while \[ \$# -gt 0 \]/ { inloop = 1; flagarm = 0; next }
		inloop && /^[ \t]*done[ \t;]*$/ { print "END " NR; inloop = 0; next }
		inloop {
			if ($0 ~ /^[ \t]*-[^)]*\)/) flagarm = 1
			else if ($0 ~ /^[ \t]*\*\)/) flagarm = 0
			if (flagarm && match($0, /([A-Za-z_][A-Za-z0-9_]*)=/, m)) print "NAME " m[1]
		}
	' "$f")
	pid=$!
	wait "$pid" || { printf '%s: could not scan for flag assignments\n' "$f" >&2; status=1; continue; }

	end=0
	names=()
	seen=""
	for record in "${records[@]}"; do
		case $record in
		"END "*) end=${record#END } ;;
		"NAME "*)
			name=${record#NAME }
			case $seen in *" $name "*) continue ;; esac
			seen="$seen $name "
			names+=("$name")
			;;
		esac
	done

	for name in "${names[@]}"; do
		hits=$(tail -n "+$((end + 1))" "$f" | grep -cE "\\\$\\{?$name\\b" || true)
		[ "$hits" -gt 0 ] && continue
		printf '%s: %s is parsed as a flag but never read after the parsing loop\n' "$f" "$name" >&2
		status=1
	done
done

[ "$status" = 0 ] && printf 'lint-dead-flag: no flag parsed and never read\n'
exit "$status"
