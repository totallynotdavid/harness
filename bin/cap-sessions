#!/usr/bin/env bash
# cap-sessions - list all agent sessions running on this machine.

. "$(dirname "$(readlink -f "$0")")/lib.sh"

session_kind() {
	local pid=$1
	local last

	last=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | tail -1 || true)

	case $last in
	-*) printf 'interactive\n' ;;
	*)
		if [ "${#last}" -ge 40 ]; then
			printf 'dispatched\n'
		else
			printf 'interactive\n'
		fi
		;;
	esac
}

session_location() {
	local cwd=$1
	local slug
	local name remote path _mode _model

	if [ "$cwd" = "$CAP_HOME" ]; then
		printf 'Captain repository\n'
		return
	fi

	case $cwd in
	"$CAP_WORK_ROOT"/*)
		slug=${cwd#"$CAP_WORK_ROOT"/}
		slug=${slug%%/*}

		if [ -d "$TASKS/$slug" ]; then
			printf 'task %s\n' "$slug"
		else
			printf 'task %s (no record)\n' "$slug"
		fi
		return
		;;
	esac

	while IFS=$'\t' read -r name remote _mode _model; do
		path=$(proj_resolve "$remote") || continue

		case $cwd in
		"$path" | "$path"/*)
			printf 'project %s\n' "$name"
			return
			;;
		esac
	done <"$PROJECTS"

	printf '%s\n' "$cwd"
}

rows=""

for harness in claude codex; do
	for pid in $(pgrep -x "$harness" 2>/dev/null || true); do
		cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
		[ -n "$cwd" ] || continue

		kind=$(session_kind "$pid")
		where=$(session_location "$cwd")
		rss=$(awk '/^VmRSS:/{print int($2/1024)}' "/proc/$pid/status" 2>/dev/null || echo 0)
		age=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' || echo '?')

		rows="$rows$pid\t$harness\t$kind\t${rss}M\t$age\t$where\n"
	done
done

if [ -z "$rows" ]; then
	echo "no agent sessions running"
	exit 0
fi

{
	printf 'PID\tHARNESS\tKIND\tRSS\tAGE\tWHERE\n'
	printf '%s' "$rows"
} | column -t -s"$(printf '\t')"
