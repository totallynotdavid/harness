#!/usr/bin/env bash
# cap-spawn - start an agent in its own worktree and terminal.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap spawn <slug> <project> [-m MODEL] [-e EFFORT] [--owns GLOB] [--scout] [--heavy|--light] [-f BRIEF]"

parse_args() {
	slug=${1:-}
	project=${2:-}
	shift 2 2>/dev/null || true

	[ -n "$slug" ] && [ -n "$project" ] || die "$usage"
	case $slug in *[!a-zA-Z0-9._-]*) die "slug must be [a-zA-Z0-9._-]" ;; esac

	model=""
	tier_override=""
	effort=""
	harness=$CAP_AGENT_HARNESS
	harness_set=0
	kind=ship
	base=""
	brief_src=""
	parent=""
	owns=""

	while [ $# -gt 0 ]; do
		case $1 in
		-m | --model)
			model=${2:?}
			shift 2
			;;
		-e | --effort)
			effort=${2:?}
			shift 2
			;;
		-H | --harness)
			harness=${2:?}
			harness_set=1
			shift 2
			;;
		--base)
			base=${2:?}
			shift 2
			;;
		--stack)
			parent=${2:?}
			shift 2
			;;
		--owns)
			owns="$owns ${2:?}"
			shift 2
			;;
		-f | --brief)
			brief_src=${2:?}
			shift 2
			;;
		--scout)
			kind=scout
			shift
			;;
		--heavy)
			[ -z "$tier_override" ] || die "use --heavy or --light, not both"
			tier_override=heavy
			shift
			;;
		--light)
			[ -z "$tier_override" ] || die "use --heavy or --light, not both"
			tier_override=cheap
			shift
			;;
		*) die "unknown flag $1" ;;
		esac
	done
}

resolve_parent() {
	parent_tip=""
	[ -n "$parent" ] || return 0

	[ -z "$base" ] || die "use --base or --stack, not both"
	[ -f "$TASKS/$parent/task.env" ] || die "no such task '$parent'"

	parent_project=$(task_field "$parent" CAP_PROJECT)
	[ "$parent_project" = "$project" ] ||
		die "$parent belongs to project $parent_project, not $project"

	[ "$(task_field "$parent" CAP_KIND)" != scout ] ||
		die "cannot stack on a scout task"

	base=cap/$parent
	parent_tip=$(git -C "$repo" rev-parse "$base" 2>/dev/null) ||
		die "$parent has no branch $base in $repo"
}

check_ownership() {
	owns=${owns# }
	case $owns in
	*"'"* | *'"'*)
		die "--owns globs may not be quoted here; pass one glob per flag"
		;;
	esac

	[ "$kind" = ship ] || return 0

	peers=""
	for other in $(task_slugs); do
		[ "$other" != "$slug" ] || continue
		[ "$(task_field "$other" CAP_PROJECT 2>/dev/null || true)" = "$project" ] || continue
		[ "$(task_field "$other" CAP_KIND 2>/dev/null || true)" = ship ] || continue
		peers="$peers $other"
	done

	[ -n "$peers" ] || return 0

	[ -n "$owns" ] ||
		die "$project already has$peers in flight; a second task needs --owns (or use cap batch)"

	for other in $peers; do
		[ -n "$(owns_read "$other")" ] ||
			die "$other claims no paths, so it owns everything; drop it or respawn it with --owns"
	done

	# Fan-out requires a verified base so sibling tasks do not inherit known failures.
	basesha=$(git -C "$repo" rev-parse --verify -q "${base:-$(git_base "$repo")}" 2>/dev/null || true)
	verified_is "$project" "$basesha" ||
		die "$project has not passed cap verify at ${basesha:0:12}; build the base before forking it again"

	if taken=$(owns_taken "$project" "$repo" "$owns" "$slug"); then
		printf 'cap: %s cannot claim scope another task holds:\n' "$slug" >&2
		printf '%s\n' "$taken" >&2
		die "narrow --owns, or deliver the task that holds it first"
	fi
}

resolve_profile() {
	role=task
	if [ "$kind" = scout ]; then
		role=scout
	fi

	if [ -z "$model" ] && [ -z "$tier_override" ]; then
		model=$(proj_model "$project" || true)
		[ -n "$model" ] && [ "$model" != '-' ] || model=""
	fi

	if [ -z "$model" ]; then
		# Tier selection still applies account sizing. -m is the explicit bypass.
		model=$(role_profile_or_die "$role" "$tier_override")
	fi

	if [ "$harness_set" = 0 ] &&
		printf '%s\n' "$CAP_ASK_PROFILES" |
			awk -v p="$model" '$1==p{f=1} END{exit !f}' 2>/dev/null; then
		# Fail before creating the worktree if the account cannot use the profile.
		if ! problem=$(profile_check "$model"); then
			die "profile '$model': $problem (run cap models)"
		fi

		read -r harness model profile_effort <<<"$(ask_profile "$model")"
		[ -n "$effort" ] || [ "$profile_effort" = '-' ] || effort=$profile_effort
	fi

	# Profiles without their own effort use the role effort, not the harness default.
	[ -n "$effort" ] || effort=$(role_effort "$role")
}

check_memory() {
	avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 99999)
	need=$(project_peak_mb "$project")
	[ "$avail" -lt "$need" ] || return 0

	printf 'cap: %s MB available, %s peaked at %s MB\n' "$avail" "$project" "$need" >&2

	reclaimable=""
	for task in $(task_slugs); do
		# Only gate-confirmed ready tasks are safe to suggest dropping.
		[ "$(task_state "$task" 2>/dev/null)" = ready ] || continue
		reclaimable="$reclaimable $task"
	done

	[ -z "$reclaimable" ] ||
		printf 'cap: finished tasks still holding their panes:%s\n' "$reclaimable" >&2

	die "run cap drop on finished tasks, or clear state/peaks/$project to re-measure"
}

prepare_task_directory() {
	dir=$(task_dir "$slug")

	# The lock may exist before task.env, so check the task record under the lock.
	task_lock "$slug"
	[ -f "$dir/task.env" ] &&
		die "task '$slug' already exists (cap drop $slug first)"

	mkdir -p "$dir"
	dir=$(cd "$dir" && pwd)

	status=$dir/status.log
	: >"$status"

	if [ "$brief_src" = "-" ]; then
		cat >"$dir/brief.md"
	elif [ -n "$brief_src" ]; then
		cp "$brief_src" "$dir/brief.md"
	else
		die "a task needs a brief: -f <file> or -f - (stdin)"
	fi

	[ -s "$dir/brief.md" ] || {
		rm -rf "$dir"
		die "brief is empty"
	}
}

create_worktree() {
	tree=$CAP_WORK_ROOT/$slug
	: "${base:=$(git_base "$repo")}"

	mkdir -p "$CAP_WORK_ROOT"

	if [ "$kind" = scout ]; then
		# Scouts get a clean detached tree and never create a branch.
		branch=""
		git -C "$repo" worktree add --detach "$tree" "$base" >/dev/null 2>&1 || {
			rm -rf "$dir"
			die "worktree add failed"
		}
		return
	fi

	branch=cap/$slug
	git -C "$repo" worktree add -b "$branch" "$tree" "$base" >/dev/null 2>&1 || {
		rm -rf "$dir"
		die "worktree add failed (branch $branch may exist)"
	}
}

cleanup_worktree() {
	[ "${done:-0}" = 1 ] && return

	git -C "$repo" worktree remove --force "$tree" 2>/dev/null || rm -rf "$tree"
	git -C "$repo" worktree prune 2>/dev/null || true
	[ -z "$branch" ] || git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
	rm -rf "$dir"
}

write_task_record() {
	cat >"$dir/task.env" <<EOF
CAP_SLUG=$slug
CAP_PROJECT=$project
CAP_REPO=$repo
CAP_TREE=$tree
CAP_BRANCH=$branch
CAP_BASE=$base
CAP_PARENT=$parent
CAP_PARENT_TIP=$parent_tip
CAP_MODE=$mode
CAP_KIND=$kind
CAP_MODEL=$model
CAP_EFFORT=$effort
CAP_HARNESS=$harness
CAP_STARTED=$(now)
CAP_OWNER=$(session_identity)
EOF
}

write_ownership_guard() {
	guard=()
	[ -n "$owns" ] || return 0

	# Enforce ownership in the launch hook instead of relying on prompt text.
	read -r -a owns_list <<<"$owns"
	owns_write "$slug" "${owns_list[@]}"
	guard=(--guard)
}

prepare_dependencies() {
	preflight_note=""
	[ "$kind" = ship ] || return 0

	# Unknown projects may continue. Known projects with failed installs may not.
	preflight_tools "$project"
	printf 'cap: preparing %s\n' "$tree" >&2

	# gitignored .env files do not follow the checkout into a worktree.
	if [ -f "$repo/.env" ] && [ ! -e "$tree/.env" ]; then
		cp "$repo/.env" "$tree/.env"
	fi

	plog=$dir/preflight.log
	prc=0
	preflight_deps "$tree" >"$plog" 2>&1 || prc=$?

	case $prc in
	0)
		preflight_note="Dependencies are installed. The worktree is ready to build."
		;;
	2)
		preflight_note="Captain could not tell how to install this project's dependencies. Set it up yourself if the task needs it."
		;;
	*)
		printf 'cap: dependency install failed in %s:\n' "$tree" >&2
		tail -20 "$plog" | sed 's/^/  /' >&2
		die "$slug: not starting an agent in a worktree that cannot install; fix the install on $base first"
		;;
	esac

	rm -f "$plog"
}

prepare_worktree() {
	prepare_task_directory
	create_worktree
	cap_exit_add cleanup_worktree
	write_task_record
	write_ownership_guard
	prepare_dependencies
}

write_contract() {
	report=$CAP_HOME/notes/$project/$slug.md

	if [ "$kind" = scout ]; then
		deliverable="Write a report at $report. Read the code; leave it unchanged."
	else
		deliverable="Leave your changes uncommitted. Do not run git commit, git push, or open a pull request."
	fi

	cat >"$dir/contract.md" <<EOF
# Task: $slug

- $deliverable
- Report failures plainly, with the output that shows them.
- Found a second problem inside your scope? Fix it and say what you fixed. A brief is what the operator could see; you can see more. Outside your scope, report it instead, because a write there belongs to another task's work.
- A tool you need is missing? Install it from its official instructions and carry on. Add it to \`config/tools/$project\` in Captain so the next worktree has it.
${owns:+- You own \`$owns\` and nothing else. Writes outside it are blocked. Need a change elsewhere? Say so in your report.
}${preflight_note:+
$preflight_note
}
## Status protocol

Append exactly one line per event to $status. Use only these prefixes and nothing else:

- done: <one-line summary> when finished. For ship, say the branch is ready for review. For scout, say the report is written and where it is.
- blocked: <reason> when stuck on something external.
- needs-input: <question> when a decision from the captain is required before continuing.
- failed: <what and why> when the task cannot be completed.
- working: <note> optionally when resuming after any of the above.

This protocol is the same for ship and scout tasks. It is in addition to, not instead of, the rule to report failures plainly. Append the line, then stop when you have finished or cannot continue.

---

$(cat "$dir/brief.md")
EOF
}

launch_agent() {
	kick="Read $dir/contract.md and carry it out."

	label=$(task_agent_label "$project" "$slug" "$(session_identity)")

	read -r pane tabid session_id <<<"$("$CAP_BIN/cap-launch" --task "$slug" --label "$label" --dir "$tree" \
		--harness "$harness" --model "$model" --effort "$effort" "${guard[@]}" "$kick")"

	[ -n "$pane" ] || die "$slug: could not start the agent session"

	printf 'CAP_PANE=%s\nCAP_TAB=%s\nCAP_SESSION_ID=%s\n' \
		"$pane" "$tabid" "$session_id" >>"$dir/task.env"
}

start_notification_watcher() {
	local log=$dir/notification.log
	local fd

	# The watcher must outlive this command so a completed pane can notify the
	# operator after cap spawn has returned to the calling session.
	(
		# Do not let the detached child keep cap spawn's task lock open.
		for fd in "${CAP_LOCK_FDS[@]}"; do
			eval "exec ${fd}>&-"
		done
		unset CAP_LOCKS CAP_LOCK_EXIT_ARMED
		exec nohup "$CAP_BIN/cap-watch" \
			--task "$slug" \
			--notify \
			--timeout 0 \
			--interval 10
	) >"$log" 2>&1 </dev/null &
}

parse_args "$@"

repo=$(proj_path "$project")
mode=$(proj_mode "$project")

[ "$mode" != ignore ] || die "$project is marked ignore in config/projects.tsv"

[ -d "$repo/.git" ] || die "$repo is not a git repo"
[ "$kind" = ship ] || mode=scout

resolve_parent
check_ownership
resolve_profile
check_memory
prepare_worktree
write_contract
launch_agent
start_notification_watcher

done=1

printf 'spawned %s  project=%s  model=%s(%s)  kind=%s  pane=%s\n' \
	"$slug" "$project" "$model" "$harness" "$kind" "$pane"
