#!/usr/bin/env python3
"""lint-transport - exercise transport, review ownership and completion state."""

import importlib.util
import io
import json
import os
import runpy
import subprocess
import sys
import tempfile
from contextlib import redirect_stdout
from pathlib import Path
from types import SimpleNamespace


ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "bin"))
import caplib  # noqa: E402


def fail(message):
    raise SystemExit(f"lint-transport: {message}")


def test_prompt_transport():
    seen = {}
    secret = "find mise run check in this private finding"
    with tempfile.NamedTemporaryFile("w", delete=False) as fh:
        fh.write(secret)
        prompt_file = fh.name

    old = {
        "argv": sys.argv,
        "run_main": caplib.run_main,
        "task_lock": caplib.task_lock,
        "trust": caplib.trust,
        "session_argv": caplib.session_argv,
        "launch": caplib.launch,
        "pane_type": caplib.pane_type,
    }
    try:
        caplib.run_main = lambda main: main()
        caplib.task_lock = lambda _: None
        caplib.trust = lambda *_: None
        caplib.session_argv = lambda harness, model, effort, prompt, **_: seen.setdefault("argv", [harness, prompt])
        caplib.launch = lambda *_args, **_kwargs: caplib.Session("claude", "p1", "t1", tempfile.mkdtemp(), "lint")
        caplib.pane_type = lambda pane, prompt: seen.update(pane=pane, prompt=prompt)
        sys.argv = [str(ROOT / "bin/cap-launch"), "--task", "t", "--dir", str(ROOT), "--harness", "claude", "--prompt-file", prompt_file]
        with redirect_stdout(io.StringIO()):
            runpy.run_path(str(ROOT / "bin/cap-launch"), run_name="__main__")
    finally:
        sys.argv = old["argv"]
        for key, value in old.items():
            if key != "argv":
                setattr(caplib, key, value)
        os.unlink(prompt_file)

    if secret in " ".join(seen.get("argv", [])):
        fail("revive prompt still reaches the harness argv")
    if seen.get("argv", [None, None])[1]:
        fail("file transport still gave the harness a positional prompt")
    if seen.get("prompt") != secret:
        fail("revive prompt was not sent through the pane")


def test_completion_state():
    with tempfile.TemporaryDirectory() as tmp:
        home = Path(tmp)
        (home / "config").mkdir()
        (home / "state").mkdir()
        (home / "config/captain.conf").write_text((ROOT / "config/captain.conf").read_text())
        script = f'. "{ROOT / "bin/lib.sh"}"; cap_completion_start check demo; exit 7'
        env = dict(os.environ, CAP_HOME=str(home))
        proc = subprocess.run(["bash", "-c", script], env=env, capture_output=True, text=True)
        if proc.returncode != 7:
            fail(f"completion fixture exited {proc.returncode}, expected 7")
        records = list((home / "state/completions").glob("*.json"))
        if len(records) != 1:
            fail("completion fixture did not leave one record")
        record = json.loads(records[0].read_text())
        if record.get("command") != "cap check demo" or record.get("exit") != 7 or record.get("state") != "completed":
            fail(f"bad completion record: {record}")
        report = subprocess.run(
            ["bash", "-c", f'. "{ROOT / "bin/lib.sh"}"; cap_completion_report'],
            env=env,
            capture_output=True,
            text=True,
        )
        if "cap check demo finished with exit 7" not in report.stdout:
            fail("completion reporter did not surface the failed command")
        if list((home / "state/completions").glob("*.json")):
            fail("completion reporter did not claim the record")


def test_exit_handlers():
    with tempfile.TemporaryDirectory() as tmp:
        home = Path(tmp)
        (home / "config").mkdir()
        (home / "state").mkdir()
        (home / "config/captain.conf").write_text((ROOT / "config/captain.conf").read_text())
        marker = home / "handlers"
        script = f'''. "{ROOT / "bin/lib.sh"}"
first() {{ printf 'first:%s\\n' "$?" >>"{marker}"; }}
second() {{ printf 'second:%s\\n' "$?" >>"{marker}"; }}
cap_exit_add first
cap_exit_add second
[ "$(type -t trap)" = builtin ]
exit 7
'''
        proc = subprocess.run(["bash", "-c", script], env=dict(os.environ, CAP_HOME=str(home)))
        if proc.returncode != 7:
            fail(f"exit-handler fixture exited {proc.returncode}, expected 7")
        if marker.read_text().splitlines() != ["first:7", "second:7"]:
            fail(f"exit handlers did not run in order: {marker.read_text()!r}")


def test_library_source_is_pure():
    with tempfile.TemporaryDirectory() as tmp:
        home = Path(tmp)
        (home / "config").mkdir()
        (home / "state").mkdir()
        (home / "config/captain.conf").write_text((ROOT / "config/captain.conf").read_text())
        subprocess.run(["git", "init", "-q", str(home)], check=True)
        proc = subprocess.run(
            ["bash", "-c", f'. "{ROOT / "bin/lib.sh"}"'],
            env=dict(os.environ, CAP_HOME=str(home)),
        )
        if proc.returncode != 0:
            fail("sourcing lib.sh failed in the pure-source fixture")
        if (home / ".git/hooks/commit-msg").exists():
            fail("sourcing lib.sh installed a Git hook")


def test_review_manifest():
    with tempfile.TemporaryDirectory() as tmp:
        old_tasks = caplib.TASKS
        caplib.TASKS = os.path.join(tmp, "tasks")
        os.makedirs(os.path.join(caplib.TASKS, "demo"))
        try:
            loader = importlib.machinery.SourceFileLoader("cap_review_lint", str(ROOT / "bin/cap-review"))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            module = importlib.util.module_from_spec(spec)
            old_run_main = caplib.run_main
            caplib.run_main = lambda _main: None
            try:
                spec.loader.exec_module(module)
            finally:
                caplib.run_main = old_run_main
            args = SimpleNamespace(slug="demo", fingerprint="f" * 64, results=os.path.join(tmp, "results"))
            module.write_manifest(args, "running", [("A", None)])
            record = json.loads((Path(caplib.TASKS) / "demo/review.json").read_text())
            if record.get("state") != "running" or record.get("pid") != os.getpid() or record.get("results") != args.results:
                fail(f"review manifest lost ownership data: {record}")
        finally:
            caplib.TASKS = old_tasks


test_prompt_transport()
test_completion_state()
test_exit_handlers()
test_library_source_is_pure()
test_review_manifest()
if "cap_completion_report" not in (ROOT / "bin/hooks/crew-status.sh").read_text():
    fail("crew-status hook does not read completion state")
print("lint-transport: prompts, review ownership and completions are durable")
