#!/usr/bin/env bash
set -euo pipefail

# CAP_HOME may be overridden; CAP_BIN always points to this script's directory.
CAP_HOME=${CAP_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
CAP_BIN=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

export CAP_HOME
export CAP_BIN

usage() {
  cat <<'EOF'
cap <command> - run coding agents from one place.

AGENTS
  cap spawn <slug> <project> [-m MODEL] [-e EFFORT] [-H claude|codex]
                             [--scout] [--heavy|--light] [--base REF]
                             [--stack SLUG]
                             [-f BRIEF|-]                          start an agent
  cap crew [--json]                           show agent status
  cap sessions                                show every agent session on this box
  cap wave [list|check|spawn] <name>          dispatch a partitioned set of tasks
  cap peek <slug> [lines]                     show recent agent output
  cap send <slug|session> [--take] "<text>"   send a message to an agent
  cap watch [--timeout S] [--interval S]      wait until an agent needs input

REVIEW AND DELIVERY
  cap check <slug>                            run checks for an agent
  cap check --repo <project> [--base REF]     run checks for a project
  cap verify <slug> [--take]                  run the project's own tests/lint/typecheck
  cap cleanup <slug> [profile] [--take]       clean up comments and readability
  cap gate <slug> [--full] [--take]           review changes (B only, or A+B with --full)
  cap step <slug> [STEP] [--take]             advance a task: check, verify, cleanup, gate, commit
  cap commit <slug> [profile] [--take]        stage and commit changes
  cap land <slug> [--merge] [--squash|--rebase|--merge-commit] [--take]
                                                   push, open a PR, merge, or file a scout report
  cap restack <slug> [--undo [SNAP]] [--take] move stacked tasks onto this task's tip
  cap drop <slug> [--force] [--take]          stop an agent; keep unlanded work by default

CONSULT
  cap ask <profile|@role> "<prompt>" [--dir D] [--label L] run a one-shot agent
  cap ask --list                              list profiles
  cap budget                                  show what can be dispatched now
  cap models [--refresh]                      show what each harness offers
  cap doctor [--diff REPORT]                  describe this host, or compare with another

REPO
  cap map [--sync]                            rebuild map.md; --sync adds new projects
  cap reconcile [--remote]                    show open work across all projects
  cap papercut add <subject> "<text>"         log a problem in Captain (cap papercut subjects)
  cap project <name> [mode] [model]           show or change project settings
  cap grant <slug> <path> [--take]            add a path to a task's ownership boundary
  cap skills list|add|rm|sync|diff            manage skill snapshots
  cap conventions <project>                   create project conventions
  cap explore <owner/repo> [--fresh]          clone a repo for inspection
  cap explore --list | --rm <slug>            manage cloned repos
  cap history --repo <name>|--task <slug> [opts]  search agent history

--take (above) claims a task a live session other than yours owns.

Projects: config/projects.tsv
Config:   config/captain.conf
EOF
}

cmd=${1:-help}
shift || true

case $cmd in
  spawn|crew|peek|send|watch|land|restack|drop|ask|budget|doctor|models|cleanup|commit|gate|step|map|reconcile|papercut|project|grant|skills|check|verify|conventions|explore|history|sessions|wave)
    exec "$CAP_BIN/cap-$cmd" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
