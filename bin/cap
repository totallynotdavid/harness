#!/usr/bin/env bash
# cap - run Captain commands.
set -euo pipefail
CAP_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export CAP_HOME

usage() {
cat <<'EOF'
cap <command> - run coding agents from one place.

AGENTS
  cap spawn <slug> <project> [-m MODEL] [-e EFFORT] [-H claude|codex]
                             [--scout] [--heavy|--light] [--base REF]
                             [--stack SLUG]
                             [-f BRIEF|-]                          start an agent
  cap crew [--json]                           show agent status
  cap peek <slug> [lines]                     show recent agent output
  cap send <slug> "<text>"                    send a message to an agent
  cap watch [--timeout S] [--interval S]      wait until an agent needs input

REVIEW AND DELIVERY
  cap check <slug>                            run checks for an agent
  cap check --repo <project> [--base REF]     run checks for a project
  cap verify <slug>                           run the project's own tests/lint/typecheck
  cap cleanup <slug> [profile]                clean up comments and readability
  cap gate <slug> [--full]                    review changes (B only, or A+B with --full)
  cap commit <slug> [profile]                 stage and commit changes
  cap land <slug> [--merge]                   push, open a PR, merge, or file a scout report
  cap restack <slug> [--undo [SNAPSHOT]]      move stacked tasks onto this task's tip
  cap drop <slug> [--force]                   stop an agent; keep unlanded work by default

CONSULT
  cap ask <profile|@role> "<prompt>" [--dir D] run a one-shot agent
  cap ask --list                              list profiles
  cap budget                                  show what can be dispatched now
  cap models [--refresh]                      show what each harness offers

REPO
  cap map [--sync]                            rebuild map.md; --sync adds new projects
  cap reconcile [--remote]                    show open work across all projects
  cap papercut "<text>"                       log a problem in Captain
  cap project <name> [mode] [model]           show or change project settings
  cap skills list|add|rm|sync|diff            manage skill snapshots
  cap conventions <project>                   create project conventions
  cap explore <owner/repo> [--fresh]          clone a repo for inspection
  cap explore --list | --rm <slug>            manage cloned repos
  cap history --repo <name>|--task <slug> [opts]  search agent history

Projects: config/projects.tsv
Config:   config/captain.conf
EOF
}

cmd=${1:-help}; shift || true
case $cmd in
  spawn|crew|peek|send|watch|land|restack|drop|ask|budget|models|cleanup|commit|gate|map|reconcile|papercut|project|skills|check|verify|conventions|explore|history)
    exec "$CAP_HOME/bin/cap-$cmd" "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
