#!/usr/bin/env bash
# cap-watch - wait for task activity or timeout.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

timeout=1800
interval=10

while [ $# -gt 0 ]; do
	case $1 in
	--timeout)
		timeout=${2:?}
		shift 2
		;;
	--interval)
		interval=${2:?}
		shift 2
		;;
	*)
		die "unknown flag $1"
		;;
	esac
done

report() {
	printf '%s %s %s\n' "$1" "$2" "$3"
	found_event=1
}

check_status() {
	local slug=$1
	local line verb

	while IFS= read -r line; do
		verb=$(task_status_verb "$line")

		case $verb in
		done) report DONE "$slug" "$line" ;;
		blocked) report BLOCKED "$slug" "$line" ;;
		needs-input) report NEEDS_INPUT "$slug" "$line" ;;
		failed) report FAILED "$slug" "$line" ;;
		esac
	done <<<"$(task_status_lines "$slug")"
}

check_task() {
	local slug=$1
	local reported=$TASKS/$slug/reported
	local age changed

	[ -f "$TASKS/$slug/task.env" ] || return

	if ! pane_live "$slug"; then
		if grep -qx exited "$reported" 2>/dev/null; then
			return
		fi

		echo exited >"$reported"
		report EXITED "$slug" "pane closed - cap deliver $slug or cap drop $slug"
		return
	fi

	live=$((live + 1))
	check_status "$slug"

	[ "$found_event" = 1 ] && return

	read -r age changed <<<"$(task_idle_age "$slug")"

	if [ "$changed" = 1 ]; then
		rm -f "$reported"
	fi

	if [ "$age" -ge "$CAP_IDLE_SECS" ]; then
		if grep -qx idle "$reported" 2>/dev/null; then
			return
		fi

		echo idle >"$reported"
		report IDLE "$slug" "quiet ${age}s - cap peek $slug"
	fi
}

deadline=$(($(now) + timeout))

while [ "$(now)" -lt "$deadline" ]; do
	slugs=$(task_slugs)

	if [ -z "$slugs" ]; then
		echo "NONE no agents running"
		exit 0
	fi

	found_event=0
	live=0

	for slug in $slugs; do
		check_task "$slug"
	done

	[ "$found_event" = 1 ] && exit 0
	[ "$live" = 0 ] && exit 0

	sleep "$interval"
done

echo "TIMEOUT no agent needed input in ${timeout}s"
