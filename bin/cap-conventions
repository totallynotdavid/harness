#!/usr/bin/env bash
# cap-conventions: create a project's convention file.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

project=${1:?usage: cap conventions <project>}
repo=$(proj_path "$project")
out=$CAP_HOME/cases/$project/conventions.md

mkdir -p "$(dirname "$out")"

if [ -f "$out" ]; then
	printf '%s\n' "$out"
	exit 0
fi

srcs=""
for file in AGENTS.md CLAUDE.md CONTRIBUTING.md docs/README.md README.md; do
	if [ -f "$repo/$file" ]; then
		srcs="$srcs $file"
	fi
done

cat >"$out" <<EOF
# $project conventions

Initialized from:${srcs:- none found}

Project-specific rules for cap check and review.
Project instruction files remain authoritative.

## Surfaces

Files that should change together.

\`\`\`surfaces
# changed-pattern -> required-pattern
# ^src/cli/ -> ^docs/
\`\`\`

## House norms

Project-specific rules that change or extend the default checks.

## Subsystem invariants

System rules that cannot be detected from a diff alone.

## Gate-miss ledger

cap deliver writes an entry for every blocker or major finding raised after an
earlier gate round passed the same bytes. Add human-caught misses by hand.
EOF

printf 'wrote %s\n' "$out"

if [ -n "$srcs" ]; then
	printf 'read these project instructions:%s\n' "$srcs"
fi
