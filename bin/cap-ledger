#!/usr/bin/env python3
"""cap-ledger - record gate misses in project conventions."""

import fcntl
import os
import subprocess
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import caplib  # noqa: E402

HEADING = "## Gate-miss ledger"


def read_rounds(slug):
    path = os.path.join(caplib.TASKS, slug, "findings.jsonl")
    return list(caplib.read_jsonl(path))


def covered_files(record):
    checked = {item.get("file") for item in record.get("checked", [])}
    findings = {item.get("file") for item in record.get("findings", [])}
    return checked | findings


def misses(records):
    found = []

    for index, later in enumerate(records):
        if later.get("verdict") != "FAIL":
            continue

        later_files = later.get("files") or {}

        for finding in later.get("findings", []):
            if finding.get("severity") not in caplib.FAILING:
                continue

            path = finding.get("file")
            file_bytes = later_files.get(path)
            if not file_bytes:
                continue

            for earlier in records[:index]:
                if earlier.get("verdict") != "PASS":
                    continue

                if path not in covered_files(earlier):
                    continue

                earlier_files = earlier.get("files") or {}
                if earlier_files.get(path) != file_bytes:
                    continue

                found.append((earlier, later, finding))

    return found


def entry(slug, earlier, later, finding):
    path = finding["file"]
    line = finding.get("line")
    location = f"{path}:{line}" if line else path

    return (
        f"- {time.strftime('%Y-%m-%d')} {slug}: "
        f"gate {earlier['label']} ({earlier['profile']}) passed "
        f"`{path}` at {earlier['commit'][:7]}; "
        f"gate {later['label']} ({later['profile']}) then found, "
        f"in the same bytes: [{finding['severity']}] "
        f"`{location}` {finding['claim']} "
        f"(finding {finding['id']}, missed by gate {earlier['label']})"
    )


def conventions_path(project):
    path = os.path.join(caplib.HOME, "cases", project, "conventions.md")
    if os.path.isfile(path):
        return path

    env = dict(os.environ, CAP_HOME=caplib.HOME)
    subprocess.run(
        [os.path.join(caplib.BIN, "cap-conventions"), project],
        check=True,
        stdout=subprocess.DEVNULL,
        env=env,
    )

    return path


def finding_key(line):
    return line.rsplit("(finding ", 1)[1]


def append_entries(path, lines):
    with open(path) as fh:
        text = fh.read()

    fresh = [line for line in lines if finding_key(line) not in text]
    fresh = list(dict.fromkeys(fresh))

    if not fresh:
        return []

    if HEADING not in text:
        text = text.rstrip("\n") + f"\n\n{HEADING}\n"

    start = text.index(HEADING) + len(HEADING)
    end = text.find("\n## ", start)
    if end < 0:
        end = len(text)

    section = text[start:end].rstrip("\n")
    section += "\n\n" + "\n".join(fresh) + "\n"

    with open(path, "w") as fh:
        fh.write(text[:start] + section + text[end:])

    return fresh


def commit_entries(path, slug, lines):
    home = caplib.HOME

    inside = subprocess.run(
        ["git", "-C", home, "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        text=True,
    )
    if inside.returncode != 0:
        return 0

    rel = os.path.relpath(path, home)

    # Read HEAD so a retry also commits entries written by an earlier failed run.
    committed = subprocess.run(
        ["git", "-C", home, "show", f"HEAD:{rel}"],
        capture_output=True,
        text=True,
    ).stdout

    pending = {
        finding_key(line)
        for line in lines
        if finding_key(line) not in committed
    }
    if not pending:
        return 0

    commands = [
        ["add", "--", rel],
        [
            "commit",
            "-q",
            "--only",
            "-m",
            f"Record gate misses from {slug}",
            "--",
            rel,
        ],
    ]

    for args in commands:
        proc = subprocess.run(
            ["git", "-C", home, *args],
            capture_output=True,
            text=True,
        )
        if proc.returncode == 0:
            continue

        error = (proc.stderr or proc.stdout).strip()
        raise caplib.CapError(
            f"{rel} has {len(pending)} gate miss(es) from {slug} "
            f"that did not commit: git {args[0]}: {error}"
        )

    return len(pending)


def main():
    if len(sys.argv) != 2:
        raise caplib.CapError("usage: cap-ledger <slug>")

    slug = sys.argv[1]
    project = caplib.task_field(slug, "CAP_PROJECT")
    if not project:
        raise caplib.CapError(f"no such task '{slug}'")

    caplib.task_lock(slug)

    found = misses(read_rounds(slug))
    if not found:
        return 0

    lines = [entry(slug, earlier, later, finding) for earlier, later, finding in found]

    # Projects share conventions.md and all ledger commits share this repository's index.
    lock = os.path.join(caplib.HOME, "state", "ledger.lock")
    os.makedirs(os.path.dirname(lock), exist_ok=True)

    with open(lock, "w") as held:
        fcntl.flock(held, fcntl.LOCK_EX)

        path = conventions_path(project)
        written = append_entries(path, lines)
        committed = commit_entries(path, slug, lines)

    if written or committed:
        count = max(len(written), committed)
        print(f"recorded {count} gate miss(es) in {path}")

    return 0


if __name__ == "__main__":
    caplib.run_main(main)
