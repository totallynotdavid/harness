#!/usr/bin/env python3
"""cap-ledger - write a landed task's gate misses into its project's conventions (used by cap land).

A gate miss is a blocker or major finding one gate raised on a file whose exact
bytes an earlier gate round had already passed while covering that file. Both
facts come from state/tasks/<slug>/findings.jsonl, so the ledger records what
the gates did, not what anyone remembered about them.
"""

import fcntl
import os
import subprocess
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import caplib  # noqa: E402

HEADING = "## Gate-miss ledger"


def rounds(slug):
    return list(caplib.read_jsonl(os.path.join(caplib.TASKS, slug, "findings.jsonl")))


def covered(record):
    return {c.get("file") for c in record.get("checked", [])} | {f.get("file") for f in record.get("findings", [])}


def misses(records):
    """(missed round, finding round, finding) for every finding an earlier PASS had passed over."""
    found = []
    for i, later in enumerate(records):
        if later.get("verdict") != "FAIL":
            continue
        for finding in later.get("findings", []):
            if finding.get("severity") not in caplib.FAILING:
                continue
            path = finding.get("file")
            bytes_then = (later.get("files") or {}).get(path)
            for earlier in records[:i]:
                if earlier.get("verdict") != "PASS" or path not in covered(earlier):
                    continue
                if bytes_then and (earlier.get("files") or {}).get(path) == bytes_then:
                    found.append((earlier, later, finding))
    return found


def entry(slug, earlier, later, finding):
    where = f"{finding['file']}:{finding['line']}" if finding.get("line") else finding["file"]
    return (
        f"- {time.strftime('%Y-%m-%d')} {slug}: gate {earlier['label']} ({earlier['profile']}) passed "
        f"`{finding['file']}` at {earlier['commit'][:7]}; gate {later['label']} ({later['profile']}) then found, "
        f"in the same bytes: [{finding['severity']}] `{where}` {finding['claim']} (finding {finding['id']}, missed by gate {earlier['label']})"
    )


def conventions(project):
    path = os.path.join(caplib.HOME, "cases", project, "conventions.md")
    if not os.path.isfile(path):
        env = dict(os.environ, CAP_HOME=caplib.HOME)
        subprocess.run([os.path.join(caplib.BIN, "cap-conventions"), project], check=True, stdout=subprocess.DEVNULL, env=env)
    return path


def finding_key(line):
    return line.rsplit("(finding ", 1)[1]


def append(path, lines):
    """Add entries not already in the ledger to the end of its section."""
    with open(path) as fh:
        text = fh.read()
    fresh = [line for line in lines if finding_key(line) not in text]
    fresh = list(dict.fromkeys(fresh))
    if not fresh:
        return []
    if HEADING not in text:
        text = text.rstrip("\n") + f"\n\n{HEADING}\n"
    start = text.index(HEADING) + len(HEADING)
    end = text.find("\n## ", start)
    end = len(text) if end < 0 else end
    section = text[start:end].rstrip("\n") + "\n\n" + "\n".join(fresh) + "\n"
    with open(path, "w") as fh:
        fh.write(text[:start] + section + text[end:])
    return fresh


def commit(path, slug, lines):
    """Commit the ledger in the hub, so a land never leaves it dirty for the next one.

    What to commit is read from HEAD, not from what this run appended, so a
    retry after a failed commit still commits the entries an earlier run wrote.
    Returns how many entries the commit added; 0 when HEAD already has them.
    """
    home = caplib.HOME
    inside = subprocess.run(["git", "-C", home, "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
    if inside.returncode != 0:
        return 0
    rel = os.path.relpath(path, home)
    committed = subprocess.run(["git", "-C", home, "show", f"HEAD:{rel}"], capture_output=True, text=True).stdout
    pending = {finding_key(line) for line in lines if finding_key(line) not in committed}
    if not pending:
        return 0
    for args in (["add", "--", rel], ["commit", "-q", "--only", "-m", f"Record gate misses from {slug}", "--", rel]):
        proc = subprocess.run(["git", "-C", home, *args], capture_output=True, text=True)
        if proc.returncode != 0:
            raise caplib.CapError(f"{rel} has {len(pending)} gate miss(es) from {slug} that did not commit: git {args[0]}: {(proc.stderr or proc.stdout).strip()}")
    return len(pending)


def main():
    if len(sys.argv) != 2:
        raise caplib.CapError("usage: cap-ledger <slug>")
    slug = sys.argv[1]
    project = caplib.task_field(slug, "CAP_PROJECT")
    if not project:
        raise caplib.CapError(f"no such task '{slug}'")
    caplib.task_lock(slug)
    found = misses(rounds(slug))
    if not found:
        return 0
    lines = [entry(slug, *m) for m in found]
    # Tasks on one project share its conventions.md, and every task's ledger
    # commit shares the hub's index, so the lock is the hub's, not the task's.
    lock = os.path.join(caplib.HOME, "state", "ledger.lock")
    os.makedirs(os.path.dirname(lock), exist_ok=True)
    with open(lock, "w") as held:
        fcntl.flock(held, fcntl.LOCK_EX)
        path = conventions(project)
        written = append(path, lines)
        committed = commit(path, slug, lines)
    if written or committed:
        print(f"recorded {max(len(written), committed)} gate miss(es) in {path}")
    return 0


if __name__ == "__main__":
    caplib.run_main(main)
