#!/usr/bin/env python3
"""Search agent history by project, task, sender, or text.

Reads JSONL session logs from ~/.claude/projects.
Only user and assistant text is included.
"""

import argparse
import glob
import json
import os
import sys
from datetime import datetime, timezone


def proj_path(cap_home, name):
    tsv = os.path.join(cap_home, "config", "projects.tsv")
    if not os.path.isfile(tsv):
        return None
    with open(tsv) as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) > 1 and parts[0] == name:
                return os.path.expanduser(parts[1])
    return None


def task_tree(cap_home, slug):
    env_file = os.path.join(cap_home, "state", "tasks", slug, "task.env")
    if not os.path.isfile(env_file):
        return None
    with open(env_file) as f:
        for line in f:
            if line.startswith("CAP_TREE="):
                return line.rstrip("\n").split("=", 1)[1]
    return None


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [
            b.get("text", "")
            for b in content
            if isinstance(b, dict) and b.get("type") == "text"
        ]
        return "\n".join(p for p in parts if p)
    return ""


def parse_since(s):
    if not s:
        return None
    return datetime.fromisoformat(s).replace(tzinfo=timezone.utc)


def main():
    ap = argparse.ArgumentParser(prog="cap history", description=__doc__)
    ap.add_argument("--repo", help="project name or repo basename")
    ap.add_argument("--task", help="task slug; searches its worktree")
    ap.add_argument("--sender", choices=["user", "assistant", "both"], default="both")
    ap.add_argument("--grep", default="", help="case-insensitive text filter")
    ap.add_argument("--since", default="", help="YYYY-MM-DD")
    ap.add_argument(
        "--limit", type=int, default=200, help="maximum number of recent matches"
    )
    ap.add_argument(
        "--include-meta", action="store_true", help="include generated wrapper turns"
    )
    ap.add_argument("--full", action="store_true", help="show full turns")
    args = ap.parse_args()

    if not args.repo and not args.task:
        ap.error("one of --repo or --task is required")

    cap_home = os.environ.get("CAP_HOME") or os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )

    if args.task:
        target = task_tree(cap_home, args.task)
        if not target:
            print(
                f"no such task '{args.task}' (or it has no CAP_TREE)", file=sys.stderr
            )
            sys.exit(1)
        label = f"task={args.task}"
    else:
        target = proj_path(cap_home, args.repo)
        label = f"repo={args.repo}"

    since_dt = parse_since(args.since)
    logs_root = os.path.expanduser("~/.claude/projects")

    hits = []
    for path in sorted(
        glob.glob(os.path.join(logs_root, "**", "*.jsonl"), recursive=True)
    ):
        with open(path, errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue

                try:
                    o = json.loads(line)
                except json.JSONDecodeError:
                    continue

                t = o.get("type")
                if t not in ("user", "assistant"):
                    continue
                if args.sender != "both" and t != args.sender:
                    continue
                if o.get("isSidechain"):
                    continue
                if o.get("isMeta") and not args.include_meta:
                    continue

                cwd = o.get("cwd", "")
                if target:
                    if not (cwd == target or cwd.startswith(target.rstrip("/") + "/")):
                        continue
                elif os.path.basename(cwd.rstrip("/")) != args.repo:
                    continue

                text = text_of(o.get("message", {}).get("content")).strip()
                if not text:
                    continue

                ts = o.get("timestamp", "")
                if since_dt and ts:
                    try:
                        turn_dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
                        if turn_dt < since_dt:
                            continue
                    except ValueError:
                        pass

                if args.grep and args.grep.lower() not in text.lower():
                    continue

                hits.append((ts, t, text))

    if not hits:
        print(f"no matches for {label}", file=sys.stderr)
        sys.exit(1)

    hits.sort(key=lambda h: h[0])

    for ts, role, text in hits[-args.limit :]:
        snippet = (
            text if (args.full or len(text) <= 2000) else text[:2000] + " [truncated]"
        )
        print(f"=== {ts} {role} ===")
        print(snippet)
        print()


if __name__ == "__main__":
    main()
