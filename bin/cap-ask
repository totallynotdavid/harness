#!/usr/bin/env python3
"""cap-ask - run a profile in a real session and print its answer."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import caplib  # noqa: E402

USAGE = 'usage: cap ask <profile|@role> "<prompt>"|- [--dir D]'


def list_profiles():
    print("PROFILE\tHARNESS\tMODEL\tEFFORT")
    for line in caplib.conf("CAP_ASK_PROFILES").splitlines():
        fields = line.split()
        if len(fields) == 4:
            print("\t".join(fields))
    return 0


def parse(argv):
    if len(argv) < 2:
        raise caplib.CapError(USAGE)
    spec, prompt, rest = argv[0], argv[1], argv[2:]
    directory = os.getcwd()
    while rest:
        if rest[0] == "--dir" and len(rest) > 1:
            directory = rest[1]
            rest = rest[2:]
        else:
            raise caplib.CapError(USAGE)
    if prompt == "-":
        prompt = sys.stdin.read()
    if not prompt.strip():
        raise caplib.CapError("nothing to ask")
    if not os.path.isdir(directory):
        raise caplib.CapError(f"no such directory {directory}")
    return spec, prompt, directory


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["--list"]:
        return list_profiles()
    spec, prompt, directory = parse(argv)
    profile = caplib.resolve_profile(spec)
    caplib.check_profile(profile)

    # An agent asked to work inside a task's worktree is held to that task's
    # ground and its lock, the same as the task's own agent.
    slug = caplib.task_for_tree(directory)
    if slug:
        caplib.task_lock(slug)
        caplib.lib("task_owner_check", slug)
        if not os.path.isfile(os.path.join(caplib.TASKS, slug, "owns")):
            slug = None

    answer = caplib.ask(profile, prompt, directory, guard_slug=slug)
    print(answer.text)
    return 0


caplib.run_main(main)
