#!/usr/bin/env bash
# cap-ask - run a profile and print its output.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

if [ "${1:-}" = --list ]; then
  printf 'PROFILE\tHARNESS\tMODEL\n'
  printf '%s\n' "$CAP_ASK_PROFILES" | awk 'NF==3{print $1"\t"$2"\t"$3}'
  exit 0
fi

profile=${1:?usage: cap ask <profile|@role> "<prompt>" [--dir D]}
shift

# A role is resolved to a profile here, at the moment of the call, rather than
# in configuration. A captain session that has been open for hours dispatches a
# smaller model once the account's window fills, and a larger one again after
# it resets, without anyone editing anything or being told to.
case $profile in
  @*)
    role=${profile#@}
    profile=$(role_profile_or_die "$role")
    printf 'cap: role %s -> %s\n' "$role" "$profile" >&2
    ;;
esac

prompt=${1:?usage: cap ask <profile> "<prompt>"}
shift || true

dir=$PWD
[ "${1:-}" = --dir ] && {
  dir=${2:?}
  shift 2
}

[ "$prompt" = "-" ] && prompt=$(cat)

read -r harness model <<<"$(ask_profile "$profile")"

have "$harness" || die "$harness is not installed"
require_herdr

harness_trust "$harness" "$dir"

# Use the harness default model when none is set.
margs=()
[ "$model" != '-' ] && margs=(--model "$model")

# Resuming after a session-limit rejection (see docs/pipeline-notes.md).
# Claude-harness only: this is the account-quota rejection cap-ask detects
# below, which codex/luna does not hit. Keyed on the exact (profile, dir,
# prompt) triple so a genuine retry of the same call finds it, and any
# other call does not. Policy is a hard threshold, not a judgment call:
#   - pending session under 30% context used  -> resume directly.
#   - pending session at/above 30%            -> start fresh, UNLESS the
#     caller explicitly sets CAP_ASK_RESUME=force, in which case resume but
#     always compact first (never resume a large session uncompacted).
resume_id=""
resume_compact=0
resume_file=""
if [ "$harness" = claude ]; then
  resume_key=$(printf '%s\x1e%s\x1e%s' "$profile" "$dir" "$prompt" | sha256sum | cut -c1-16)
  resume_file="$CAP_HOME/state/ask-resume/$resume_key.json"
  if [ -f "$resume_file" ]; then
    prev_id=$(jq -r '.session_id // empty' "$resume_file" 2>/dev/null || true)
    prev_ctx=$(jq -r '.ctx_pct // empty' "$resume_file" 2>/dev/null || true)
    if [ -n "$prev_id" ]; then
      if [ -n "$prev_ctx" ] && [ "$prev_ctx" -lt 30 ] 2>/dev/null; then
        resume_id=$prev_id
      elif [ "${CAP_ASK_RESUME:-}" = force ]; then
        resume_id=$prev_id
        resume_compact=1
      else
        warn "pending session $prev_id is at ${prev_ctx:-an unknown}% context (>=30%); starting fresh instead of resuming. Set CAP_ASK_RESUME=force to resume it (always compacts first)."
        rm -f "$resume_file"
      fi
    fi
  fi
fi

continue_prompt="Continue exactly where you left off in this conversation and finish the task. If you already reached a final conclusion before being interrupted, just restate it clearly now."

launch_prompt=$prompt
resume_args=()
if [ -n "$resume_id" ]; then
  resume_args=(--resume "$resume_id")
  launch_prompt=$([ "$resume_compact" = 1 ] && printf '/compact' || printf '%s' "$continue_prompt")
fi

case $harness in
  claude)
    cmd=(env "${CAP_ENV_SCRUB[@]}" "${CAP_CACHE_ENV[@]}" claude "${resume_args[@]}" "${margs[@]}" $CAP_AGENT_FLAGS "$launch_prompt")
    ;;
  codex)
    cmd=(env "${CAP_ENV_SCRUB[@]}" "${CAP_CACHE_ENV[@]}" codex "${margs[@]}"
         --dangerously-bypass-approvals-and-sandbox "$prompt")
    ;;
  *)
    die "unknown harness '$harness'"
    ;;
esac

read -r pane _ <<<"$(herdr_open "$dir" "ask-$profile-$$")"
pane_launch "$pane" "${cmd[@]}"

# Wait for the agent to appear.
for _ in $(seq 1 50); do
  herdr agent get "$pane" >/dev/null 2>&1 && break
  sleep 0.1
done

# Wait for the agent to start and finish.
: "$(herdr agent wait "$pane" --until working --timeout 10000 2>&1)"
herdr agent wait "$pane" >/dev/null 2>&1 ||
  die "herdr agent wait failed for $pane"

# Compact-then-continue is two turns in the same session: /compact above,
# then the real continuation prompt submitted into the same still-open pane.
if [ "$resume_compact" = 1 ]; then
  herdr agent prompt "$pane" "$continue_prompt" --wait >/dev/null 2>&1 || true
  herdr agent wait "$pane" >/dev/null 2>&1 ||
    die "herdr agent wait failed for $pane (after compact)"
fi

out=$(herdr pane read "$pane" --source recent-unwrapped --format text 2>/dev/null)

session_id=""
if [ "$harness" = claude ]; then
  session_id=$(herdr agent get "$pane" 2>/dev/null | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)
fi

herdr pane close "$pane" >/dev/null 2>&1

printf '%s\n' "$out"

# The claude harness can silently truncate its response when the account is
# out of quota, producing output that looks like a terse-but-normal answer.
# There is no codex equivalent here: nothing in this branch runs for a codex
# profile, so a codex rung is never taken out of a ladder. Captain measures no
# codex quota at all (see paper-cuts.md).
# Fail loudly and distinctly instead of letting a caller mistake this for a
# real result (e.g. an empty gate verdict) - and record enough to resume
# this exact call next time instead of paying to re-derive it from scratch.
if [ "$harness" = claude ] && printf '%s' "$out" | grep -qF "hit your session limit"; then
  reset_at=$(printf '%s' "$out" | grep -oE "resets [^·]*\(UTC\)" | head -1)
  ctx_pct=$(printf '%s' "$out" | grep -oE "ctx [0-9]+% used" | grep -oE '[0-9]+' | head -1)
  # Take this profile out of every ladder until its window resets. This is the
  # only quota signal that is never an estimate: the account itself said no.
  profile_block "$profile" "$(limit_reset_epoch "$harness" "$reset_at")"
  if [ -n "$session_id" ] && [ -n "$resume_file" ]; then
    mkdir -p "$(dirname "$resume_file")"
    jq -n --arg id "$session_id" --arg ctx "${ctx_pct:-100}" \
      '{session_id: $id, ctx_pct: ($ctx | tonumber)}' >"$resume_file" 2>/dev/null || true
  fi
  die "claude harness hit its session limit (${reset_at:-reset time unknown}); output above is truncated, not a real result. Retrying this exact call later will resume session ${session_id:-unknown} (recorded at ${ctx_pct:-unknown}% context)."
fi

# A retry that succeeded past a recorded rejection has nothing left to resume.
# `[ -n "$resume_file" ] && rm -f ...` as the script's last statement would
# make cap-ask exit 1 whenever resume_file is unset - i.e. every non-claude
# harness call, including every Gate B round - because the test's own false
# result becomes the whole script's exit code with nothing after it to mask
# it. Under a caller's `set -e`/pipefail (cap-gate) that silently discarded
# a correct result: Gate B's PASS/FAIL was printed but never reached
# gate_record, and cap-gate died before its own final summary line. `if`
# always exits 0 when its condition is false, unlike `&&`.
if [ -n "$resume_file" ]; then
  rm -f "$resume_file"
fi
