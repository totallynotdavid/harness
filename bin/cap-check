#!/usr/bin/env bash
# cap-check - run checks for a task or project.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

repo=""
base=""
project=""

if [ -n "${1:-}" ] && [ -d "$TASKS/${1:-}" ]; then
	task_load "$1"
	task_lock "$1"
	repo=$CAP_TREE
	base=$CAP_BASE
	project=$CAP_PROJECT
	shift
else
	while [ $# -gt 0 ]; do
		case $1 in
		--repo)
			project=${2:?}
			repo=$(proj_path "$2")
			shift 2
			;;
		--base)
			base=${2:?}
			shift 2
			;;
		*) die "usage: cap check <slug> | cap check --repo <project> [--base REF]" ;;
		esac
	done
fi

[ -n "$repo" ] || die "usage: cap check <slug> | cap check --repo <project> [--base REF]"
: "${base:=$(git_base "$repo")}"

git -C "$repo" rev-parse --verify -q "$base" >/dev/null || die "no base ref '$base'"

conv=$CAP_HOME/cases/$project/conventions.md

# Diff from the merge base, never the base tip. A task forked before other work
# landed shows every one of those later commits as its own change: aula-fulfilment
# listed 20 changed files, 19 of which were aula-scope's, landed underneath it.
# docs/pipeline-notes.md calls this out and the collisions check below already
# does it; this is the same bug in the other place it mattered.
diff_from=$(git -C "$repo" merge-base "$base" HEAD 2>/dev/null || true)
[ -n "$diff_from" ] || diff_from=$base

changed=$({
	git -C "$repo" diff --name-only "$diff_from"
	git -C "$repo" ls-files --others --exclude-standard
} | sort -u)

[ -n "$changed" ] || {
	echo "no changes against $base"
	exit 0
}

findings=0

note() {
	findings=$((findings + 1))
	printf '  ! %s\n' "$*"
}

# Find matches outside changed files.
outside() {
	{
		git -C "$repo" grep -lE "\\b$1" -- . 2>/dev/null || true
	} | {
		grep -vxF "$changed" || true
	} | head -5
}

# `git diff` only sees tracked files, so a new file, which is most of what an
# agent writes, appeared in `changed` above but contributed no added lines to
# any check below. The em-dash gate reported ok on a page carrying two of
# them. Untracked files are diffed against /dev/null so they arrive in the
# same +-prefixed form as an edit to an existing file.
diff_text=$({
	git -C "$repo" diff -U0 "$diff_from"
	git -C "$repo" ls-files --others --exclude-standard -z |
		while IFS= read -r -d '' f; do
			git -C "$repo" diff --no-index --no-color -U0 -- /dev/null "$f" 2>/dev/null || true
		done
} || true)

printf '## changed (worktree vs %s)\n' "$base"
printf '%s\n' "$changed" | sed 's/^/  /'

# Check whether another live task in this project is changing the same files.
# Parallel tasks collide on files no brief assigned, and a per-task check that
# only compares one worktree against the base cannot see it. A landed task
# clears itself: once its branch is merged, its diff against the base is empty.
printf '\n## collisions\n'
collide=0
if [ -n "$project" ]; then
	for other in $(task_slugs); do
		[ "$other" != "${CAP_SLUG:-}" ] || continue
		[ "$(task_field "$other" CAP_PROJECT)" = "$project" ] || continue

		otree=$(task_field "$other" CAP_TREE)
		[ -n "$otree" ] && [ -e "$otree/.git" ] || continue
		obase=$(task_field "$other" CAP_BASE)
		git -C "$otree" rev-parse --verify -q "$obase" >/dev/null 2>&1 || continue

		# Diff from the merge base, not the base tip. When the base has moved
		# on since the task started, everything landed in the meantime looks
		# like this task changed it.
		omb=$(git -C "$otree" merge-base "$obase" HEAD 2>/dev/null) || continue
		ochanged=$({
			git -C "$otree" diff --name-only "$omb" 2>/dev/null || true
			git -C "$otree" ls-files --others --exclude-standard 2>/dev/null || true
		} | sort -u)
		[ -n "$ochanged" ] || continue

		shared=$(printf '%s\n' "$changed" |
			grep -xF -f <(printf '%s\n' "$ochanged") 2>/dev/null || true)
		[ -n "$shared" ] && {
			note "$other is changing the same files:"
			printf '%s\n' "$shared" | sed 's/^/      /'
			collide=1
		}
	done
fi
[ "$collide" = 0 ] && echo "  ok"

# Two signals about added comments, both reported rather than refused. A
# comment that narrates history is stating what the commit message already
# says, and a comment block past six lines is usually defending a decision
# instead of explaining one. Both point at code worth a second look.
printf '\n## comments\n'
history=$(printf '%s\n' "$diff_text" | awk '
	/^\+\+\+/ { next }
	/^\+[[:space:]]*(\/\/|#|\*|--)/ {
		line = tolower($0)
		if (line ~ /used to |previously|no longer|before this|originally|was (failing|timing|broken)|had to be/) {
			print substr($0, 2)
			if (++hits >= 8) exit
		}
	}')
[ -z "$history" ] || {
	printf '%s\n' "$history" | sed 's/^/      /'
	note "added comments narrate history; state the current contract instead"
}

long=$(printf '%s\n' "$diff_text" | awk '
	/^\+\+\+/ { next }
	/^\+[[:space:]]*(\/\/|#|\*|--)/ { n++; next }
	{ if (n > 6) c++; n = 0 }
	END { if (n > 6) c++; print c + 0 }')
[ "$long" = 0 ] || note "$long added comment block(s) run past six lines"

[ -n "$history" ] || [ "$long" != 0 ] || echo "  ok"

# Check related files that should change together.
printf '\n## surfaces\n'
if [ -f "$conv" ] && grep -q '^```surfaces' "$conv"; then
	while read -r trigger _arrow required; do
		case ${trigger:-} in '' | '#'*) continue ;; esac
		[ -n "${required:-}" ] || continue
		printf '%s\n' "$changed" | grep -qE "$trigger" || continue
		printf '%s\n' "$changed" | grep -qE "$required" ||
			note "changed $trigger without $required"
	done < <(sed -n '/^```surfaces/,/^```$/p' "$conv" | grep -v '^```')

	[ "$findings" = 0 ] && echo "  ok"
else
	echo "  no surface map - run: cap conventions ${project:-<project>}"
fi

# Check removed names for remaining references.
printf '\n## stale\n'
removed=$({
	printf '%s\n' "$diff_text" |
		grep '^-[^-]' |
		grep -oE '\b(export (const|function|class)|def|fn|func) [A-Za-z_][A-Za-z0-9_]*' |
		awk '{print $NF}' |
		sort -u
} || true)

stale=0
for id in $removed; do
	# Not `printf ... | grep -q`: under pipefail, grep -q's early exit on a
	# match (this diff can be 70KB+) sends SIGPIPE to printf before it
	# finishes writing, and the pipeline then reports printf's 141 instead of
	# grep's 0 - a real match gets masked as "not found" and a symbol still
	# in the diff gets flagged as removed. A here-string has no pipe to break.
	grep -q "^+.*\b$id\b" <<<"$diff_text" && continue

	hits=$(outside "$id")
	[ -n "$hits" ] && {
		note "removed '$id' still referenced:"
		printf '%s\n' "$hits" | sed 's/^/      /'
		stale=1
	}
done

[ "$stale" = 0 ] && echo "  ok"

# Show callers of changed functions.
printf '\n## callers\n'
touched=$({
	printf '%s\n' "$diff_text" |
		grep '^[+-][^+-]' |
		grep -oE '\b(export (async )?function|async function|function|def|fn|func) [A-Za-z_][A-Za-z0-9_]*' |
		awk '{print $NF}' |
		sort -u
} || true)

callers=0
for fn in $touched; do
	sites=$(outside "$fn *\\(")
	[ -n "$sites" ] && {
		printf '  ? %s called outside the diff:\n' "$fn"
		printf '%s\n' "$sites" | sed 's/^/      /'
		callers=1
	}
done

[ "$callers" = 0 ] && echo "  ok"
[ "$callers" = 1 ] && echo "  (check each caller or acknowledge it)"

# Find files related to changed filenames.
printf '\n## siblings\n'
sib=0
for f in $changed; do
	key=$(basename "$f" | sed 's/\.[^.]*$//')
	[ ${#key} -ge 5 ] || continue

	hits=$(outside "$key")
	[ -n "$hits" ] && {
		printf '  ? %s mentioned in:\n' "$key"
		printf '%s\n' "$hits" | sed 's/^/      /'
		sib=1
	}
done

[ "$sib" = 0 ] && echo "  ok"

printf '\n%s deterministic finding(s)\n' "$findings"
[ "$findings" = 0 ]
