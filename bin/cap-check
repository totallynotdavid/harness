#!/usr/bin/env bash
# cap-check - run checks for a task or project.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap check <slug> | cap check --repo <project> [--base REF]"

repo=""
base=""
project=""
slug=""

resolve_target() {
	if [ -n "${1:-}" ] && [ -d "$TASKS/${1:-}" ]; then
		[ "$#" = 1 ] || die "$usage"
		slug=$1
		task_load "$1"

		# Check the task under its lock without claiming session ownership.
		task_lock "$1"

		repo=$CAP_TREE
		base=$CAP_BASE
		project=$CAP_PROJECT
		return
	fi

	while [ $# -gt 0 ]; do
		case $1 in
		--repo)
			project=${2:?}
			repo=$(proj_path "$2")
			shift 2
			;;
		--base)
			base=${2:?}
			shift 2
			;;
		*)
			die "$usage"
			;;
		esac
	done
}

resolve_target "$@"

[ -n "$repo" ] || die "$usage"

: "${base:=$(git_base "$repo")}"
cap_completion_start check "${slug:-$project}"

git -C "$repo" rev-parse --verify -q "$base" >/dev/null ||
	die "no base ref '$base'"

conv=$CAP_HOME/cases/$project/conventions.md
diff_from=$(diff_base "$repo" "$base")

changed=$({
	git -C "$repo" diff --name-only "$diff_from"
	git -C "$repo" ls-files --others --exclude-standard
} | sort -u)

[ -n "$changed" ] || {
	[ -z "$slug" ] || step_record "$slug" check 0
	echo "no changes against $base"
	exit 0
}

findings=0

note() {
	findings=$((findings + 1))
	printf '  ! %s\n' "$*"
}

files_outside_diff() {
	local needle=$1
	local repo=$2
	local changed=$3
	local hits
	local count
	local max=${4:-0}

	hits=$({
		git -C "$repo" grep -lE "\\b$needle" -- . 2>/dev/null || true
	} | {
		grep -vxF "$changed" || true
	})

	[ -n "$hits" ] || return 0

	count=$(printf '%s\n' "$hits" | wc -l)

	# Broad filename matches are noise. 0 keeps all matches for checks where
	# widespread references make the finding more useful.
	if [ "$max" != 0 ] && [ "$count" -gt "$max" ]; then
		return 0
	fi

	printf '%s\n' "$hits" | head -5

	if [ "$count" -gt 5 ]; then
		printf 'and %s more\n' "$((count - 5))"
	fi
}

# Git does not include untracked files in a normal diff.
diff_text=$({
	git -C "$repo" diff -U0 "$diff_from"

	git -C "$repo" ls-files --others --exclude-standard -z |
		while IFS= read -r -d '' f; do
			git -C "$repo" diff --no-index --no-color -U0 -- /dev/null "$f" \
				2>/dev/null || true
		done
} || true)

printf '## changed (worktree vs %s)\n' "$base"
printf '%s\n' "$changed" | sed 's/^/  /'

printf '\n## collisions\n'

collide=0

if [ -n "$project" ]; then
	for other in $(task_slugs); do
		[ "$other" != "${CAP_SLUG:-}" ] || continue
		[ "$(task_field "$other" CAP_PROJECT)" = "$project" ] || continue

		otree=$(task_field "$other" CAP_TREE)
		[ -n "$otree" ] && [ -e "$otree/.git" ] || continue

		obase=$(task_field "$other" CAP_BASE)
		git -C "$otree" rev-parse --verify -q "$obase" >/dev/null 2>&1 ||
			continue

		# Using the base tip would treat changes delivered after the task started
		# as changes made by that task.
		omb=$(git -C "$otree" merge-base "$obase" HEAD 2>/dev/null) ||
			continue

		ochanged=$({
			git -C "$otree" diff --name-only "$omb" 2>/dev/null || true
			git -C "$otree" ls-files --others --exclude-standard \
				2>/dev/null || true
		} | sort -u)

		[ -n "$ochanged" ] || continue

		shared=$(printf '%s\n' "$changed" |
			grep -xF -f <(printf '%s\n' "$ochanged") 2>/dev/null || true)

		if [ -n "$shared" ]; then
			note "$other is changing the same files:"
			printf '%s\n' "$shared" | sed 's/^/      /'
			collide=1
		fi
	done
fi

[ "$collide" = 0 ] && echo "  ok"

printf '\n## comments\n'

history=$(printf '%s\n' "$diff_text" | awk '
	/^\+\+\+ / {
		path = $0
		sub(/^\+\+\+ (b\/|a\/)/, "", path)
		generated = path ~ /(^|\/)frontend\/wailsjs\// ||
			path ~ /(^|\/)build\/(windows|darwin)\//
		next
	}
	generated { next }
	/^\+[[:space:]]*#!/ { next }
	/^\+[[:space:]]*(\/\/|#|\*|--([[:space:]]|$))/ {
		line = tolower($0)
		if (line ~ /used to (be|have|[[:alpha:]]+ed)([[:space:]]|$)|previously|no longer|before this|originally|was (failing|timing|broken)|had to be/) {
			print substr($0, 2)
			if (++hits >= 8) exit
		}
	}')

if [ -n "$history" ]; then
	printf '%s\n' "$history" | sed 's/^/      /'
	note "added comments narrate history; state the current contract instead"
fi

long=$(printf '%s\n' "$diff_text" | awk '
	/^\+\+\+ / {
		path = $0
		sub(/^\+\+\+ (b\/|a\/)/, "", path)
		generated = path ~ /(^|\/)frontend\/wailsjs\// ||
			path ~ /(^|\/)build\/(windows|darwin)\//
		n = 0
		next
	}
	generated { next }
	/^\+[[:space:]]*#!/ { n = 0; next }
	/^\+[[:space:]]*(\/\/|#|\*|--([[:space:]]|$))/ { n++; next }
	{ if (n > 6) c++; n = 0 }
	END { if (n > 6) c++; print c + 0 }')

[ "$long" = 0 ] ||
	note "$long added comment block(s) run past six lines"

[ -n "$history" ] || [ "$long" != 0 ] || echo "  ok"

printf '\n## surfaces\n'

if [ -f "$conv" ] && grep -q '^```surfaces' "$conv"; then
	surface_findings=$findings

	# Capture the block first so a read failure is not mistaken for an empty map.
	surfaces=$(sed -n '/^```surfaces/,/^```$/p' "$conv") ||
		note "could not read the surface map in $conv"

	while read -r trigger _arrow required; do
		case ${trigger:-} in
		'' | '#'* | '```'*) continue ;;
		esac

		[ -n "${required:-}" ] || continue
		printf '%s\n' "$changed" | grep -qE "$trigger" || continue

		printf '%s\n' "$changed" | grep -qE "$required" ||
			note "changed $trigger without $required"
	done <<<"$surfaces"

	[ "$findings" = "$surface_findings" ] && echo "  ok"
else
	echo "  no surface map - run: cap conventions ${project:-<project>}"
fi

printf '\n## stale\n'

removed=$({
	printf '%s\n' "$diff_text" |
		grep '^-[^-]' |
		grep -oE '\b(export (const|function|class)|def|fn|func) [A-Za-z_][A-Za-z0-9_]*' |
		awk '{print $NF}' |
		sort -u
} || true)

stale=0

for id in $removed; do
	# A grep -q pipeline can make printf exit on SIGPIPE and hide a real match
	# under pipefail. The here-string avoids that pipeline.
	grep -q "^+.*\b$id\b" <<<"$diff_text" && continue

	hits=$(files_outside_diff "$id" "$repo" "$changed")

	if [ -n "$hits" ]; then
		note "removed '$id' still referenced:"
		printf '%s\n' "$hits" | sed 's/^/      /'
		stale=1
	fi
done

[ "$stale" = 0 ] && echo "  ok"

printf '\n## callers\n'

touched=$({
	printf '%s\n' "$diff_text" |
		grep '^[+-][^+-]' |
		grep -oE '\b(export (async )?function|async function|function|def|fn|func) [A-Za-z_][A-Za-z0-9_]*' |
		awk '{print $NF}' |
		sort -u
} || true)

callers=0

for fn in $touched; do
	sites=$(files_outside_diff "$fn *\\(" "$repo" "$changed")

	if [ -n "$sites" ]; then
		printf '  ? %s called outside the diff:\n' "$fn"
		printf '%s\n' "$sites" | sed 's/^/      /'
		callers=1
	fi
done

[ "$callers" = 0 ] && echo "  ok"
[ "$callers" = 1 ] && echo "  (check each caller or acknowledge it)"

printf '\n## siblings\n'

sib=0

while IFS= read -r f; do
	key=$(basename "$f" | sed 's/\.[^.]*$//')
	[ "${#key}" -ge 5 ] || continue

	hits=$(files_outside_diff "$key" "$repo" "$changed" "$CAP_CHECK_SIBLING_MAX")

	if [ -n "$hits" ]; then
		printf '  ? %s mentioned in:\n' "$key"
		printf '%s\n' "$hits" | sed 's/^/      /'
		sib=1
	fi
done <<<"$changed"

[ "$sib" = 0 ] && echo "  ok"

printf '\n%s deterministic finding(s)\n' "$findings"

[ -z "$slug" ] || step_record "$slug" check "$findings"
[ "$findings" = 0 ]
