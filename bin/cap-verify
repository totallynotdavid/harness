#!/usr/bin/env bash
# cap-verify - run a task's own test/lint/typecheck commands directly, no
# model session. Answers "is this actually fixed" deterministically for
# anything the project's own tooling can check, instead of spending a gate
# round to re-derive the same answer (see docs/pipeline-notes.md).
. "$(dirname "$(readlink -f "$0")")/lib.sh"

# Two subjects, one procedure. A task is verified in its worktree; a project is
# verified in its own checkout, which is how a base earns the right to be
# forked more than once.
again=0
if [ "${1:-}" = --again ]; then again=1; shift; fi

if [ "${1:-}" = --repo ]; then
  CAP_PROJECT=${2:?usage: cap verify --repo <project>}
  CAP_TREE=$(proj_path "$CAP_PROJECT")
  slug=$CAP_PROJECT
  [ -d "$CAP_TREE/.git" ] || die "$CAP_TREE is not a git repo"
else
  slug=${1:?usage: cap verify <slug> | cap verify --repo <project>}
  task_load "$slug"
fi

cd "$CAP_TREE" || die "$slug: no worktree at $CAP_TREE"

sha=$(git -C "$CAP_TREE" rev-parse HEAD 2>/dev/null || true)
dirty=$(git_dirty "$CAP_TREE")

# Which scripts already passed at this commit, so a run that dies partway
# through resumes instead of starting over. The build is both the most
# expensive script and the first thing a constrained box kills, which is the
# combination that keeps a run from ever reaching the end. Only a clean tree
# earns an entry: a pass with uncommitted changes says nothing about the
# commit.
progress=""
if [ -n "$sha" ] && [ "$dirty" = 0 ]; then
  mkdir -p "$VERIFIED/$CAP_PROJECT"
  progress=$VERIFIED/$CAP_PROJECT/$sha.scripts
  [ "$again" = 0 ] || rm -f "$progress"
fi

already_passed() {
  [ -n "$progress" ] && grep -qxF "$1" "$progress" 2>/dev/null
}

mark_passed() {
  [ -n "$progress" ] || return 0
  already_passed "$1" || printf '%s\n' "$1" >>"$progress"
}

status=0
failed=()
# A die before any check leaves status at 0, so the trap needs to know whether
# anything actually ran before it records a commit as verified.
ran=0

# Every check runs with stdin closed. A check that inherits this script's
# stdin consumes the rest of the task list feeding the loop below, so only the
# first check runs and cap-verify still exits 0: `mise run check` (docker
# compose underneath) swallowed the list and check:certificate never ran.
# Record the high-water mark while the project's own tooling runs. This is the
# only place the harness watches a real build, so it is the only place a
# capacity number can come from that is not a guess.
peak_kb=0
# A script that finishes its work and then refuses to exit looks exactly like
# one still working, so the gate needs a ceiling to call it failed. `nuxt
# build` does this whenever the dev database directory already exists, which
# is why the ceiling is not theoretical.
CAP_VERIFY_MAX=${CAP_VERIFY_MAX:-900}
capped() {
  local pid rc
  # Job control gives the background job its own process group, so the kill
  # below reaches pnpm's node grandchild too. Without it the signal lands on
  # the direct child alone and the grandchild keeps the memory.
  set -m
  "$@" </dev/null &
  pid=$!
  set +m
  (
    sleep "$CAP_VERIFY_MAX"
    kill -0 "$pid" 2>/dev/null || exit 0
    kill -TERM -- "-$pid" 2>/dev/null
    sleep 5
    kill -KILL -- "-$pid" 2>/dev/null
  ) &
  local watcher=$!
  rc=0
  wait "$pid" || rc=$?
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  if [ "$rc" -gt 128 ]; then
    # The child dying on the watcher's TERM ends the wait above, which stops
    # the watcher before it can escalate. Sweep the group here so a grandchild
    # that ignored TERM cannot outlive the run.
    kill -KILL -- "-$pid" 2>/dev/null || true
    printf 'no exit within %ss, killed the process tree\n' "$CAP_VERIFY_MAX" >&2
  fi
  return "$rc"
}

run() {
  local key=$*
  if already_passed "$key"; then
    printf '=== %s === (passed earlier at this commit)\n' "$key"
    return 0
  fi
  printf '=== %s ===\n' "$key"
  local m rss rc
  if [ -x /usr/bin/time ]; then
    m=$(mktemp)
    capped /usr/bin/time -f '%M' -o "$m" "$@"; rc=$?
    if [ "$rc" = 0 ]; then mark_passed "$key"; else status=1; failed+=("$key"); fi
    rss=$(tail -1 "$m" 2>/dev/null || echo 0)
    rm -f "$m"
    case $rss in '' | *[!0-9]*) rss=0 ;; esac
    [ "$rss" -le "$peak_kb" ] || peak_kb=$rss
  else
    capped "$@"; rc=$?
    if [ "$rc" = 0 ]; then mark_passed "$key"; else status=1; failed+=("$key"); fi
  fi
}

# A count of what ran is not a verdict. The failing script has to be named in
# the last line, because that is the line the reader acts on.
report_result() {
  if [ "$status" = 0 ]; then
    printf '\n%s %s(s) run, all green\n' "$1" "$2"
  else
    printf '\nFAILED: %s\n' "$(printf '%s, ' "${failed[@]}" | sed 's/, $//')"
    printf '%s of %s %s(s) failed\n' "${#failed[@]}" "$1" "$2"
  fi
}

on_exit() {
  if [ "$peak_kb" -gt 0 ]; then
    project_peak_record "$CAP_PROJECT" "$((peak_kb / 1024))"
    printf 'peak %s MB for %s\n' "$((peak_kb / 1024))" "$CAP_PROJECT"
  fi
  # Only a clean tree earns the record. A pass with uncommitted changes says
  # nothing about the commit anyone else would fork from.
  if [ "$ran" = 1 ] && [ "$status" = 0 ] && [ "$dirty" = 0 ]; then
    verified_record "$CAP_PROJECT" "$sha"
    [ -z "$progress" ] || rm -f "$progress"
    printf '%s verified at %s\n' "$CAP_PROJECT" "${sha:0:12}"
  fi
}
trap on_exit EXIT

if [ -f mise.toml ] && have mise; then
  tasks=$(
    {
      grep -oE '^\[tasks\."?[A-Za-z0-9_:.-]+"?\]' mise.toml |
        sed -E 's/^\[tasks\."?([^"]+)"?\]/\1/'
      awk '/^\[tasks\]$/{f=1;next} /^\[/{f=0} f && /^[A-Za-z0-9_-]+[[:space:]]*=/{sub(/[[:space:]]*=.*/,""); print}' mise.toml
    } | sort -u
  )
  matched=$(printf '%s\n' "$tasks" | grep -E '^(test|lint|typecheck|check|format-check)([:.-].*)?$' || true)
  [ -n "$matched" ] || die "$slug: no test/lint/typecheck mise tasks found in $CAP_TREE/mise.toml"
  # Read the list into an array first, so the loop body never has the list
  # itself as its stdin.
  mapfile -t list <<<"$matched"
  for t in "${list[@]}"; do
    [ -n "$t" ] || continue
    run mise run "$t"
  done
  ran=1
  report_result "${#list[@]}" task
  exit $status
fi

if [ -f package.json ]; then
  pm=npm
  [ -f pnpm-lock.yaml ] && pm=pnpm
  [ -f yarn.lock ] && pm=yarn
  have jq || die "$slug: jq is required to read package.json scripts"
  scripts=$(jq -r '.scripts // {} | keys[]' package.json 2>/dev/null || true)
  # `build` belongs here: a project whose tests pass but which does not
  # compile is not verified.
  # build runs last, not alphabetically. It is the script that exhausts memory
  # on a constrained box, so everything cheaper banks a pass before the run is
  # at risk.
  matched=$(printf '%s\n' "$scripts" | grep -E '^(test|lint|typecheck|check|build)$' |
    sort -k1,1 | awk '$0 == "build" { b = $0; next } { print } END { if (b) print b }' || true)
  [ -n "$matched" ] || die "$slug: no test/lint/typecheck scripts found in $CAP_TREE/package.json"
  mapfile -t list <<<"$matched"
  for s in "${list[@]}"; do
    [ -n "$s" ] || continue
    run "$pm" run "$s"
  done
  ran=1
  report_result "${#list[@]}" script
  exit $status
fi

die "$slug: don't know how to verify $CAP_TREE (no mise.toml or package.json); run its checks by hand"
