#!/usr/bin/env bash
# cap-verify - run a task's own test/lint/typecheck commands directly, no
# model session. Answers "is this actually fixed" deterministically for
# anything the project's own tooling can check, instead of spending a gate
# round to re-derive the same answer (see docs/pipeline-notes.md).
. "$(dirname "$(readlink -f "$0")")/lib.sh"

# Two subjects, one procedure. A task is verified in its worktree; a project is
# verified in its own checkout, which is how a base earns the right to be
# forked more than once.
if [ "${1:-}" = --repo ]; then
  CAP_PROJECT=${2:?usage: cap verify --repo <project>}
  CAP_TREE=$(proj_path "$CAP_PROJECT")
  slug=$CAP_PROJECT
  [ -d "$CAP_TREE/.git" ] || die "$CAP_TREE is not a git repo"
else
  slug=${1:?usage: cap verify <slug> | cap verify --repo <project>}
  task_load "$slug"
fi

cd "$CAP_TREE" || die "$slug: no worktree at $CAP_TREE"

sha=$(git -C "$CAP_TREE" rev-parse HEAD 2>/dev/null || true)
dirty=$(git_dirty "$CAP_TREE")

status=0
# A die before any check leaves status at 0, so the trap needs to know whether
# anything actually ran before it records a commit as verified.
ran=0

# Every check runs with stdin closed. A check that inherits this script's
# stdin consumes the rest of the task list feeding the loop below, so only the
# first check runs and cap-verify still exits 0: `mise run check` (docker
# compose underneath) swallowed the list and check:certificate never ran.
# Record the high-water mark while the project's own tooling runs. This is the
# only place the harness watches a real build, so it is the only place a
# capacity number can come from that is not a guess.
peak_kb=0
run() {
  printf '=== %s ===\n' "$*"
  local m rss
  if [ -x /usr/bin/time ]; then
    m=$(mktemp)
    /usr/bin/time -f '%M' -o "$m" "$@" </dev/null || status=1
    rss=$(tail -1 "$m" 2>/dev/null || echo 0)
    rm -f "$m"
    case $rss in '' | *[!0-9]*) rss=0 ;; esac
    [ "$rss" -le "$peak_kb" ] || peak_kb=$rss
  else
    "$@" </dev/null || status=1
  fi
}

on_exit() {
  if [ "$peak_kb" -gt 0 ]; then
    project_peak_record "$CAP_PROJECT" "$((peak_kb / 1024))"
    printf 'peak %s MB for %s\n' "$((peak_kb / 1024))" "$CAP_PROJECT"
  fi
  # Only a clean tree earns the record. A pass with uncommitted changes says
  # nothing about the commit anyone else would fork from.
  if [ "$ran" = 1 ] && [ "$status" = 0 ] && [ "$dirty" = 0 ]; then
    verified_record "$CAP_PROJECT" "$sha"
    printf '%s verified at %s\n' "$CAP_PROJECT" "${sha:0:12}"
  fi
}
trap on_exit EXIT

if [ -f mise.toml ] && have mise; then
  tasks=$(
    {
      grep -oE '^\[tasks\."?[A-Za-z0-9_:.-]+"?\]' mise.toml |
        sed -E 's/^\[tasks\."?([^"]+)"?\]/\1/'
      awk '/^\[tasks\]$/{f=1;next} /^\[/{f=0} f && /^[A-Za-z0-9_-]+[[:space:]]*=/{sub(/[[:space:]]*=.*/,""); print}' mise.toml
    } | sort -u
  )
  matched=$(printf '%s\n' "$tasks" | grep -E '^(test|lint|typecheck|check|format-check)([:.-].*)?$' || true)
  [ -n "$matched" ] || die "$slug: no test/lint/typecheck mise tasks found in $CAP_TREE/mise.toml"
  # Read the list into an array first, so the loop body never has the list
  # itself as its stdin.
  mapfile -t list <<<"$matched"
  for t in "${list[@]}"; do
    [ -n "$t" ] || continue
    run mise run "$t"
  done
  ran=1
  printf '\n%s task(s) run\n' "${#list[@]}"
  exit $status
fi

if [ -f package.json ]; then
  pm=npm
  [ -f pnpm-lock.yaml ] && pm=pnpm
  [ -f yarn.lock ] && pm=yarn
  have jq || die "$slug: jq is required to read package.json scripts"
  scripts=$(jq -r '.scripts // {} | keys[]' package.json 2>/dev/null || true)
  matched=$(printf '%s\n' "$scripts" | grep -E '^(test|lint|typecheck|check)$' || true)
  [ -n "$matched" ] || die "$slug: no test/lint/typecheck scripts found in $CAP_TREE/package.json"
  mapfile -t list <<<"$matched"
  for s in "${list[@]}"; do
    [ -n "$s" ] || continue
    run "$pm" run "$s"
  done
  ran=1
  printf '\n%s script(s) run\n' "${#list[@]}"
  exit $status
fi

die "$slug: don't know how to verify $CAP_TREE (no mise.toml or package.json); run its checks by hand"
