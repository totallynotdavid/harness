#!/usr/bin/env bash
# cap-verify - run project-defined checks without a model session.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap verify <slug> [--again] [--take] | cap verify --repo <project> [--again]"

again=0
take=0
repo=0
project=""
slug=""

while [ $# -gt 0 ]; do
  case $1 in
  --again)
    again=1
    shift
    ;;
  --take)
    take=1
    shift
    ;;
  --repo)
    [ -n "${2:-}" ] || die "$usage"
    repo=1
    project=$2
    shift 2
    ;;
  -*)
    die "$usage"
    ;;
  *)
    [ -z "$slug" ] || die "$usage"
    slug=$1
    shift
    ;;
  esac
done

if [ "$repo" = 1 ]; then
  [ -z "$slug" ] || die "$usage"
  [ "$take" = 0 ] || die "$usage"

  CAP_PROJECT=$project
  CAP_TREE=$(proj_path "$CAP_PROJECT")
  slug=$CAP_PROJECT

  [ -d "$CAP_TREE/.git" ] || die "$CAP_TREE is not a git repo"
  project_lock "$CAP_PROJECT"
else
  [ -n "$slug" ] || die "$usage"

  task_load "$slug"
  task_lock "$slug"

  if [ "$take" = 1 ]; then
    task_owner_take "$slug"
  else
    task_owner_claim "$slug"
  fi
fi

cd "$CAP_TREE" || die "$slug: no worktree at $CAP_TREE"

sha=$(git -C "$CAP_TREE" rev-parse HEAD 2>/dev/null || true)
dirty_count=$(git_dirty "$CAP_TREE")

progress=""
if [ -n "$sha" ] && [ "$dirty_count" = 0 ]; then
  mkdir -p "$VERIFIED/$CAP_PROJECT"
  progress=$VERIFIED/$CAP_PROJECT/$sha.scripts

  [ "$again" = 0 ] || rm -f "$progress"
fi

already_passed() {
  [ -n "$progress" ] && grep -qxF "$1" "$progress" 2>/dev/null
}

mark_passed() {
  [ -n "$progress" ] || return 0
  already_passed "$1" || printf '%s\n' "$1" >>"$progress"
}

status=0
failed=()
ran=0
peak_kb=0
CAP_VERIFY_MAX=${CAP_VERIFY_MAX:-900}

capped() {
  local pid watcher rc

  # The check needs its own process group so a timeout also kills children
  # such as pnpm's node process.
  set -m
  "$@" </dev/null &
  pid=$!

  # Kill the watcher as a group so its sleep process does not survive a
  # completed check.
  (
    sleep "$CAP_VERIFY_MAX"
    kill -0 "$pid" 2>/dev/null || exit 0
    kill -TERM -- "-$pid" 2>/dev/null
    sleep 5
    kill -KILL -- "-$pid" 2>/dev/null
  ) &
  watcher=$!
  set +m

  rc=0
  wait "$pid" || rc=$?

  kill -- "-$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true

  if [ "$rc" -gt 128 ]; then
    # TERM may end the direct child before the watcher can kill children that
    # ignored it.
    kill -KILL -- "-$pid" 2>/dev/null || true
    printf 'no exit within %ss, killed the process tree\n' "$CAP_VERIFY_MAX" >&2
  fi

  return "$rc"
}

run() {
  local key=$*
  local log m rss
  local rc=0

  if already_passed "$key"; then
    printf '=== %s === (passed earlier at this commit)\n' "$key"
    return 0
  fi

  printf '=== %s ===\n' "$key"

  # A detached child can keep stdout open after the check exits. Capture to a
  # file so descendants cannot keep the caller's pipe open.
  log=$(mktemp)

  if [ -x /usr/bin/time ]; then
    m=$(mktemp)

    capped /usr/bin/time -f '%M' -o "$m" "$@" >"$log" 2>&1 || rc=$?

    rss=$(tail -1 "$m" 2>/dev/null || echo 0)
    rm -f "$m"

    case $rss in
    '' | *[!0-9]*) rss=0 ;;
    esac

    [ "$rss" -le "$peak_kb" ] || peak_kb=$rss
  else
    capped "$@" >"$log" 2>&1 || rc=$?
  fi

  if [ "$rc" = 0 ]; then
    mark_passed "$key"
  else
    status=1
    failed+=("$key")
  fi

  cat "$log"
  rm -f "$log"
}

report_result() {
  local total=$1
  local unit=$2

  if [ "$status" = 0 ]; then
    printf '\n%s %s(s) run, all green\n' "$total" "$unit"
    return
  fi

  printf '\nFAILED: %s\n' "$(printf '%s, ' "${failed[@]}" | sed 's/, $//')"
  printf '%s of %s %s(s) failed\n' "${#failed[@]}" "$total" "$unit"
}

on_exit() {
  if [ "$peak_kb" -gt 0 ]; then
    project_peak_record "$CAP_PROJECT" "$((peak_kb / 1024))"
    printf 'peak %s MB for %s\n' "$((peak_kb / 1024))" "$CAP_PROJECT"
  fi

  if [ "$ran" = 1 ] && [ "$status" = 0 ] && [ "$repo" = 0 ]; then
    step_record "$slug" verify pass
  fi

  # A dirty tree does not prove that the commit itself passes.
  if [ "$ran" = 1 ] && [ "$status" = 0 ] && [ "$dirty_count" = 0 ]; then
    verified_record "$CAP_PROJECT" "$sha"
    [ -z "$progress" ] || rm -f "$progress"
    printf '%s verified at %s\n' "$CAP_PROJECT" "${sha:0:12}"
  fi
}
cap_exit_add on_exit

mise_tasks() {
  {
    grep -oE '^\[tasks\."?[A-Za-z0-9_:.-]+"?\]' mise.toml |
      sed -E 's/^\[tasks\."?([^"]+)"?\]/\1/'

    awk '
      /^\[tasks\]$/ {
        in_tasks = 1
        next
      }
      /^\[/ {
        in_tasks = 0
      }
      in_tasks && /^[A-Za-z0-9_-]+[[:space:]]*=/ {
        sub(/[[:space:]]*=.*/, "")
        print
      }
    ' mise.toml
  } | sort -u
}

run_mise_checks() {
  [ -f mise.toml ] && have mise || return 1

  local tasks matched
  local list

  tasks=$(mise_tasks)

  # The aggregate check task already runs its dependencies.
  if printf '%s\n' "$tasks" | grep -qx 'check'; then
    matched=check
  else
    matched=$(
      printf '%s\n' "$tasks" |
        grep -E '^(test|lint|typecheck|check|format-check)([:.-].*)?$' ||
        true
    )
  fi

  [ -n "$matched" ] || return 1

  mapfile -t list <<<"$matched"

  for task in "${list[@]}"; do
    [ -n "$task" ] || continue
    run mise run "$task"
  done

  ran=1
  report_result "${#list[@]}" task
  return 0
}

run_package_checks() {
  [ -f package.json ] || return 1

  local pm=npm
  local scripts matched
  local list

  [ -f pnpm-lock.yaml ] && pm=pnpm
  [ -f yarn.lock ] && pm=yarn

  have jq || die "$slug: jq is required to read package.json scripts"

  scripts=$(jq -r '.scripts // {} | keys[]' package.json 2>/dev/null || true)

  # Build runs last because it is usually the most expensive check.
  matched=$(
    printf '%s\n' "$scripts" |
      grep -E '^(test|lint|typecheck|check|build)$' |
      sort -k1,1 |
      awk '$0 == "build" { build = $0; next } { print } END { if (build) print build }' ||
      true
  )

  [ -n "$matched" ] ||
    die "$slug: no test/lint/typecheck scripts found in $CAP_TREE/package.json"

  mapfile -t list <<<"$matched"

  for script in "${list[@]}"; do
    [ -n "$script" ] || continue
    run "$pm" run "$script"
  done

  ran=1
  report_result "${#list[@]}" script
  return 0
}

if run_mise_checks || run_package_checks; then
  exit "$status"
fi

if [ "$repo" = 0 ]; then
  step_record "$slug" verify none
  printf '%s: no checks known for %s (no mise.toml or package.json); nothing verified\n' "$slug" "$CAP_TREE"
  exit 0
fi

die "$slug: don't know how to verify $CAP_TREE (no mise.toml or package.json); run its checks by hand"
