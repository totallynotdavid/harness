#!/usr/bin/env bash
# cap-gate - independent review of a task's changes, before it lands.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

full=0
slug=""
for a in "$@"; do
  case $a in
    --full) full=1 ;;
    *) slug=$a ;;
  esac
done
[ -n "$slug" ] || die "usage: cap gate <slug> [--full]"
task_load "$slug"

sync_base "$CAP_TREE" "$CAP_BASE" ||
  die "$slug: worktree is mid-conflict after syncing onto $CAP_BASE; resolve before gating (see docs/pipeline-notes.md)"

commits=$(git -C "$CAP_TREE" rev-list --count "$CAP_BASE..HEAD" 2>/dev/null || echo 0)
dirty=$(git_dirty "$CAP_TREE")
[ "$commits" -gt 0 ] || [ "$dirty" != 0 ] || die "$slug has no changes against $CAP_BASE"

prompt="Read $CAP_HOME/rules/code.md, then review every change in this
worktree against $CAP_BASE (git diff $CAP_BASE, plus any uncommitted change).
Report concrete defects: what is wrong, where, and the failure it causes. Do
not edit files. End with a single line, exactly: GATE: PASS or GATE: FAIL."

out_dir=$CAP_HOME/notes/$CAP_PROJECT
mkdir -p "$out_dir"
mkdir -p "$TASKS/$slug"

# Gate B (cheap) runs every round. Gate A (expensive) only runs on --full: the
# first review and the pass right before landing. Running it every intermediate
# round paid for a full cold session per round even when B was the only profile
# still finding anything (see docs/pipeline-notes.md, "Gate A frequency").
#
# Both are roles, not models. cap-ask sizes each one against the account's
# current window, so a gate round late in a heavy day runs a smaller reviewer
# instead of failing to run at all.
# Resolve both gates here rather than letting each cap-ask call size itself.
# Independently sized, both gates land on the same profile whenever they share
# a tier, and a change reviewed twice by one model is not two opinions. Gate B
# asks its tier for a different peer instead.
profiles=()
gate_a=""
if [ "$full" = 1 ]; then
  gate_a=$(role_profile_or_die gate-a)
  profiles+=("A $gate_a")
fi
gate_b=$(role_profile gate-b "$gate_a" || true)
if [ -z "$gate_b" ]; then
  if [ -n "$gate_a" ]; then
    warn "no second profile is available below $gate_a; running gate B on $gate_a too, which is one opinion, not two"
    gate_b=$gate_a
  else
    gate_b=$(role_profile_or_die gate-b)
  fi
fi
profiles+=("B $gate_b")

fp=$(gate_fingerprint "$CAP_TREE" "$CAP_BASE")

# Iterate an array, never a pipe or a here-string. cap-ask launches a harness
# that inherits the loop's stdin and eats the remaining profiles, so every
# gate after the first silently never runs while the command still exits 0.
# cap-verify had the same defect against its task list.
incomplete=0
for pair in "${profiles[@]}"; do
  read -r label profile <<<"$pair"
  out=$out_dir/$slug.gate-$label.md

  printf '## gate %s (%s)\n\n' "$label" "$profile"
  # A failing cap-ask must not abort the run. set -e plus pipefail would kill
  # cap-gate right here, before the verdict check below ever runs, and cap-ask
  # exits nonzero on precisely the case that check exists for: a session-limit
  # rejection that leaves an empty report behind.
  if ! "$CAP_HOME/bin/cap-ask" "$profile" "$prompt" --dir "$CAP_TREE" </dev/null | tee "$out"; then
    warn "gate $label ($profile) did not run to completion; see $out"
  fi
  printf '\n'

  # A gate that reached no verdict is a failed gate, not a silent pass. The
  # review session can die mid-read (session limit, crashed pane) and leave a
  # zero-byte report: local-env's gate-A.md was 0 bytes and no gate.json was
  # ever written, yet cap-gate printed its reports line and said nothing else.
  # Recording UNKNOWN would be worse still, since gate.json would then claim a
  # result nobody reached.
  verdict=$(gate_verdict "$out")
  if [ "$verdict" = UNKNOWN ]; then
    warn "gate $label ($profile) reached no verdict for $slug ($(wc -c <"$out") bytes in $out); not recording a result"
    incomplete=1
    continue
  fi
  gate_record "$slug" "$label" "$verdict" "$fp"
done

printf 'reports: %s/%s.gate-A.md %s/%s.gate-B.md\n' "$out_dir" "$slug" "$out_dir" "$slug"

# Exit status is the machine-readable verdict, so a caller can chain on it:
#   0  ready to land
#   1  gates ran, the work is not ready
#   2  a gate did not complete, so nothing was learned either way
if gate_ready "$slug" "$CAP_TREE" "$CAP_BASE"; then
  printf 'READY TO LAND: %s (gate A and B both passed this exact code) - cap commit %s && cap land %s\n' \
    "$slug" "$slug" "$slug"
  exit 0
fi

# Say this on every path. It used to print only under --full, so a plain
# B-only round that produced nothing looked exactly like a clean one.
printf 'NOT ready to land: %s (see reports above)\n' "$slug"
if [ "$incomplete" != 0 ]; then
  warn "$slug: a gate did not complete; re-run cap gate $slug"
  exit 2
fi
exit 1
