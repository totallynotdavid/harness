#!/usr/bin/env bash
# cap-commit - plan and write a task's commits.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap commit <slug> [profile] [--take]"
parse_args() {
  take=0
  slug=""
  profile=""
  while [ $# -gt 0 ]; do
    case $1 in
    --take) take=1; shift ;;
    -*) die "$usage" ;;
    *)
      if [ -z "$slug" ]; then slug=$1; elif [ -z "$profile" ]; then profile=$1; else die "$usage"; fi
      shift
      ;;
    esac
  done
  [ -n "$slug" ] || die "$usage"
  profile=${profile:-@chore}
}

snapshot_tree() {
  local tmp_index
  tmp_index=$(mktemp -u)
  GIT_INDEX_FILE=$tmp_index git -C "$CAP_TREE" read-tree HEAD
  GIT_INDEX_FILE=$tmp_index git -C "$CAP_TREE" add -A
  snap_tree=$(GIT_INDEX_FILE=$tmp_index git -C "$CAP_TREE" write-tree)
  rm -f "$tmp_index"
  snap_commit=$(git -C "$CAP_TREE" commit-tree --no-gpg-sign "$snap_tree" -p HEAD -m "cap-commit snapshot: $slug")
  snap_ref="log/$slug-$(now)"
  git -C "$CAP_TREE" branch "$snap_ref" "$snap_commit"
}

extract_commit_plan() {
  local answer=$1 block
  block=$(printf '%s\n' "$answer" | awk '
    /^```json[[:space:]]*$/ { inside=1; current=""; next }
    /^```[[:space:]]*$/ && inside { last=current; inside=0; next }
    inside { current=current $0 ORS }
    END { if (inside) printf "%s", current; else if (last != "") printf "%s", last }
  ')
  if [ -n "$block" ]; then
    printf '%s' "$block"
  else
    printf '%s\n' "$answer"
  fi
}

prepare_commit_plan() {
  local changed plan_answer plan_json problems
  changed=$(git -C "$CAP_TREE" diff --no-renames --name-only "$snap_commit^" "$snap_commit")
  [ -n "$changed" ] || die "$slug has no changed paths to plan"
  plan_path=$TASKS/$slug/commit-plan.json
  plan_prompt="Read $CAP_HOME/rules/commits.md in full. Inspect the current working-tree changes without editing them or committing anything. Design the exact commit groups and messages before Captain writes the history.

Return exactly one fenced json block with this shape:
{\"commits\":[{\"summary\":\"lowercase imperative subject\",\"body\":null,\"paths\":[\"relative/path\"]}]}

Every changed path must appear exactly once. Keep files that form one logical change in the same group. The groups are written in the listed order. Use body null for a small, obvious, or pure rename change. For a change that spans several files, changes behavior, or needs context, set body to the complete description. Its first line must be \"Why: <reason>\"; it may contain further paragraphs. Encode paragraph breaks as \\n inside the JSON string. Keep the subject direct and concise. Do not use a conventional-commit prefix or a trailing period. A conventional-commit prefix is any of these words followed by a colon, with or without a (scope): revert, feat, fix, docs, style, refactor, perf, test, build, ci, chore. A change that touches only docs or only tests still needs a real area prefix naming the part of Captain being changed (e.g. \"watch: document ...\", \"watch: add a cursor-isolation test\"), never the word \"docs\" or \"test\" itself.

Changed paths:
$changed"
  plan_answer=$("$CAP_BIN/cap-ask" "$profile" "$plan_prompt" --dir "$CAP_TREE" --label "commit-plan-$slug")
  plan_json=$(extract_commit_plan "$plan_answer")
  printf '%s\n' "$plan_json" >"$plan_path"
  problems=$(commit_plan_paths_report "$plan_path" "$changed")
  [ -z "$problems" ] || die "$slug's commit plan is invalid:\n$problems"
}

parse_args "$@"
task_load "$slug"
task_lock "$slug"
if [ "$take" = 1 ]; then task_owner_take "$slug"; else task_owner_claim "$slug"; fi
cap_completion_start commit "$slug"

[ "$(git_dirty "$CAP_TREE")" != 0 ] || die "$slug's worktree is clean; nothing to commit"

snapshot_tree
prepare_commit_plan
commit_plan_write "$CAP_TREE" "$plan_path"

final_tree=$(git -C "$CAP_TREE" rev-parse HEAD^{tree})
[ "$final_tree" = "$snap_tree" ] ||
  die "$slug's history no longer matches its code: HEAD's tree differs from $snap_ref. Compare with: git -C $CAP_TREE diff $snap_ref HEAD"

bad_trailers=$(ai_trailer_report "$CAP_TREE" "$CAP_BASE")
[ -z "$bad_trailers" ] || {
  printf 'cap: %s still contains generated attribution:\n' "$slug" >&2
  printf '%s\n' "$bad_trailers" | sed 's/^/  /' >&2
  die "commit metadata cleanup failed"
}

bad_messages=$(commit_rule_report "$CAP_TREE" "$CAP_BASE")
bad_plan=$(commit_plan_report "$CAP_TREE" "$CAP_BASE" "$plan_path")
[ -z "$bad_messages" ] && [ -z "$bad_plan" ] || {
  printf 'cap: %s has commits that do not match its plan:\n' "$slug" >&2
  [ -z "$bad_messages" ] || printf '%s\n' "$bad_messages" | sed 's/^/  /' >&2
  [ -z "$bad_plan" ] || printf '%s\n' "$bad_plan" | sed 's/^/  /' >&2
  die "commit plan verification failed"
}

git -C "$CAP_TREE" branch -D "$snap_ref" >/dev/null 2>&1
