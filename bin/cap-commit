#!/usr/bin/env bash
# cap-commit - commit a task with a separate agent.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap commit <slug> [profile] [--take]"
take=0
slug=""
profile=""
while [ $# -gt 0 ]; do
  case $1 in
  --take) take=1; shift ;;
  -*) die "$usage" ;;
  *)
    if [ -z "$slug" ]; then slug=$1; elif [ -z "$profile" ]; then profile=$1; else die "$usage"; fi
    shift ;;
  esac
done
[ -n "$slug" ] || die "$usage"
profile=${profile:-@chore}
task_load "$slug"
task_lock "$slug"
if [ "$take" = 1 ]; then task_owner_take "$slug"; else task_owner_claim "$slug"; fi

[ "$(git_dirty "$CAP_TREE")" != 0 ] || die "$slug's worktree is clean; nothing to commit"

# Snapshot the full working-tree state (tracked, staged, and untracked) before
# the commit agent reshapes it into commits, so the result can be checked
# against it afterward: same tree, different history. A throwaway index keeps
# this from touching the real one the agent is about to stage with. The
# snapshot commit itself is never pushed or kept, so it does not need the
# user's signature.
tmp_index=$(mktemp -u)
GIT_INDEX_FILE=$tmp_index git -C "$CAP_TREE" add -A
snap_tree=$(GIT_INDEX_FILE=$tmp_index git -C "$CAP_TREE" write-tree)
rm -f "$tmp_index"
snap_commit=$(git -C "$CAP_TREE" commit-tree --no-gpg-sign "$snap_tree" -p HEAD -m "cap-commit snapshot: $slug")
snap_ref="log/$slug-$(now)"
git -C "$CAP_TREE" branch "$snap_ref" "$snap_commit"

prompt="Read $CAP_HOME/rules/commits.md in full. Some or all changes may
already be staged - the captain may have run git add . to review them. That
is normal, not a grouping signal. Unstage everything first (git restore
--staged . or git reset), then stage and commit every change in this
worktree yourself. Use git add -p to split unrelated changes into separate
commits. Do not edit files. Do not push."

"$CAP_BIN/cap-ask" "$profile" "$prompt" --dir "$CAP_TREE"

# shellcheck disable=SC1083 # HEAD^{tree} is git syntax, not a brace group
final_tree=$(git -C "$CAP_TREE" rev-parse HEAD^{tree})
if [ "$final_tree" = "$snap_tree" ]; then
  git -C "$CAP_TREE" branch -D "$snap_ref" >/dev/null 2>&1
else
  die "$slug's history no longer matches its code: HEAD's tree differs from the snapshot at $snap_ref. Compare with: git -C $CAP_TREE diff $snap_ref HEAD"
fi

# ai_trailer_report (bin/lib.sh) is the one reader cap-land also uses.
# Rebuilt with commit-tree, not git filter-branch, which drops -S.
bad_trailers=$(ai_trailer_report "$CAP_TREE" "$CAP_BASE")
if [ -n "$bad_trailers" ]; then
  warn "$slug: stripping AI attribution rules/commits.md forbids:"
  printf '%s\n' "$bad_trailers" | sed 's/^/  /' >&2
  declare -A remap
  new=""
  rewriting=0
  while IFS= read -r old; do
    if [ "$rewriting" = 0 ]; then
      # Untouched until the first commit that actually carries a trailer:
      # everything before it keeps its own sha, and the parent lookup below
      # falls back to that unchanged sha with no remap entry to find.
      git -C "$CAP_TREE" log -1 --format='%B' "$old" | grep -qiE "$AI_TRAILER_RE" || continue
      rewriting=1
    fi

    tree=$(git -C "$CAP_TREE" rev-parse "$old^{tree}")
    msg=$(git -C "$CAP_TREE" log -1 --format='%B' "$old" |
      grep -viE "$AI_TRAILER_RE" || true)
    [ -n "$msg" ] ||
      die "$slug: $old's message is nothing but AI attribution; fix it by hand"

    # Every parent is looked up in remap, not assumed to be whatever was
    # last rebuilt: a merge commit's second (and any later) parent is
    # base-side history outside this range, so it has no remap entry and
    # is kept as-is - rebuilding it with only the first parent would
    # silently flatten the merge into a regular commit that quietly
    # absorbs the base side's changes under its own message.
    parent_args=()
    read -ra orig_parents <<<"$(git -C "$CAP_TREE" log -1 --format='%P' "$old")"
    for p in "${orig_parents[@]}"; do parent_args+=(-p "${remap[$p]:-$p}"); done

    # Signs the rebuilt commit only if the one it replaces was itself
    # signed (%G? is anything but N, "no signature") - mirroring rather
    # than always passing -S, so this neither force-signs a repo that
    # never signs nor hard-fails one where the key just isn't loaded.
    sign_flag=()
    [ "$(git -C "$CAP_TREE" log -1 --format='%G?' "$old")" = N ] || sign_flag=(-S)

    new=$(
      GIT_AUTHOR_NAME=$(git -C "$CAP_TREE" log -1 --format='%an' "$old") \
        GIT_AUTHOR_EMAIL=$(git -C "$CAP_TREE" log -1 --format='%ae' "$old") \
        GIT_AUTHOR_DATE=$(git -C "$CAP_TREE" log -1 --format='%aI' "$old") \
        GIT_COMMITTER_NAME=$(git -C "$CAP_TREE" log -1 --format='%cn' "$old") \
        GIT_COMMITTER_EMAIL=$(git -C "$CAP_TREE" log -1 --format='%ce' "$old") \
        GIT_COMMITTER_DATE=$(git -C "$CAP_TREE" log -1 --format='%cI' "$old") \
        git -C "$CAP_TREE" commit-tree "${sign_flag[@]}" "${parent_args[@]}" "$tree" -m "$msg"
    ) || die "$slug: could not strip AI attribution automatically; fix it by hand"
    remap[$old]=$new
  done < <(git -C "$CAP_TREE" rev-list --reverse --topo-order "$CAP_BASE..HEAD")
  git -C "$CAP_TREE" update-ref HEAD "$new"

  # A rewrite that silently leaves the thing it was asked to remove must not exit 0.
  still_bad=$(ai_trailer_report "$CAP_TREE" "$CAP_BASE")
  [ -z "$still_bad" ] ||
    die "$slug: AI attribution survived the rewrite:
$(printf '%s\n' "$still_bad" | sed 's/^/  /')"
fi
