#!/usr/bin/env python3
"""cap-papercut - log, close and list friction in Captain itself.

paper-cuts.jsonl is the ledger. paper-cuts.md is generated from it, and
mise run check:papercuts fails when the two disagree, so the markdown is never
the place an entry is written.
"""

import contextlib
import fcntl
import json
import os
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import caplib  # noqa: E402

LEDGER = os.path.join(caplib.HOME, "paper-cuts.jsonl")
MARKDOWN = os.path.join(caplib.HOME, "paper-cuts.md")
MIGRATED = "unsorted"

USAGE = """usage:
  cap papercut                            show open and closed entries
  cap papercut add <subject> "<text>"     log a problem in Captain
  cap papercut close <id> "<fix>"         close an entry and say what fixed it
  cap papercut subjects                   list the subjects an entry can have"""

HEADER = """# Paper cuts

Friction in Captain itself: harness quirks, broken scripts, and skills that misfire.

Generated by `cap papercut` from `paper-cuts.jsonl`. Log with
`cap papercut add <subject> "<text>"`, close with `cap papercut close <id> "<fix>"`.

A defect in a project Captain was working on is not a paper cut. It goes in
`notes/<project>/defects.md`, where the next task on that project will find it,
and `cap papercut` refuses a project as a subject.

Closed entries stay. The "Fixed:" paragraphs are the only written record of why
several of these scripts are shaped the way they are, and other files cite them.
"""


def subjects():
    """Every part of Captain an entry can be about, read from Captain's own tree."""
    bin_dir = os.path.join(caplib.HOME, "bin")
    names = {"lib", "lint", "config", "docs", "rules", "claude", "codex", "herdr"}
    for name in os.listdir(bin_dir):
        if name.startswith("cap-"):
            names.add(name[4:])
        elif name.startswith("lint-"):
            names.add("lint")
    for name in os.listdir(os.path.join(bin_dir, "hooks")):
        names.add("hook/" + name.rsplit(".", 1)[0])
    skills = os.path.join(caplib.HOME, ".claude", "skills")
    if os.path.isdir(skills):
        names.update("skill/" + name for name in os.listdir(skills))
    return sorted(names)


def projects():
    try:
        with open(os.path.join(caplib.HOME, "config", "projects.tsv")) as fh:
            return {line.split("\t", 1)[0] for line in fh if line.strip()} - {"captain"}
    except OSError:
        return set()


def load():
    return list(caplib.read_jsonl(LEDGER))


@contextlib.contextmanager
def locked():
    """Hold the ledger for one read-modify-write, so concurrent writers queue."""
    path = os.path.join(caplib.HOME, "state", "paper-cuts.lock")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def save(entries):
    for path, text in ((LEDGER, "".join(json.dumps(e, ensure_ascii=False) + "\n" for e in entries)), (MARKDOWN, render(entries))):
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(text)
        os.replace(tmp, path)


def render(entries):
    out = [HEADER]
    for e in entries:
        mark = "x" if e["status"] == "closed" else " "
        text = e["text"]
        if e.get("fix"):
            text += f"\n\nFixed ({e['closed']}): {e['fix']}"
        first, *rest = text.split("\n")
        out.append(f"- [{mark}] #{e['id']} {e['opened']} `{e['subject']}` - {first}")
        out.extend(("  " + line) if line else "" for line in rest)
    return "\n".join(out) + "\n"


def add(subject, text):
    if subject in projects():
        raise caplib.CapError(f"{subject} is a project, not part of Captain; record it in notes/{subject}/defects.md")
    if subject not in subjects():
        raise caplib.CapError(f"unknown subject '{subject}'; run cap papercut subjects")
    if not text.strip():
        raise caplib.CapError("nothing to log")
    with locked():
        entries = load()
        entry = {
            "id": max((e["id"] for e in entries), default=0) + 1,
            "opened": time.strftime("%Y-%m-%d"),
            "subject": subject,
            "status": "open",
            "text": " ".join(text.split()),
        }
        save(entries + [entry])
    print(f"logged #{entry['id']}")


def close(ident, fix):
    if not fix.strip():
        raise caplib.CapError("say what fixed it")
    with locked():
        entries = load()
        for e in entries:
            if str(e["id"]) == ident.lstrip("#"):
                if e["status"] == "closed":
                    raise caplib.CapError(f"#{e['id']} is already closed")
                e.update(status="closed", closed=time.strftime("%Y-%m-%d"), fix=" ".join(fix.split()))
                save(entries)
                print(f"closed #{e['id']}")
                return
    raise caplib.CapError(f"no paper cut #{ident}")


def main():
    args = sys.argv[1:]
    if not args:
        sys.stdout.write(render(load()))
        return 0
    if args == ["subjects"]:
        print("\n".join(subjects()))
        return 0
    if len(args) == 3 and args[0] == "add":
        add(args[1], args[2])
        return 0
    if len(args) == 3 and args[0] == "close":
        close(args[1], args[2])
        return 0
    raise caplib.CapError(USAGE)


if __name__ == "__main__":
    caplib.run_main(main)
