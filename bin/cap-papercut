#!/usr/bin/env python3
"""cap-papercut - log and list open friction in the captain harness

paper-cuts.jsonl stores open entries. paper-cuts.md is generated from it.
Closing an entry removes it from both files.
"""

import contextlib
import fcntl
import json
import os
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import caplib  # noqa: E402

LEDGER = os.path.join(caplib.HOME, "paper-cuts.jsonl")
MARKDOWN = os.path.join(caplib.HOME, "paper-cuts.md")
MIGRATED = "unsorted"

USAGE = """usage:
  cap papercut                            show open entries
  cap papercut add <subject> "<text>"     log a problem in Captain
  cap papercut close <id>                 remove a fixed entry
  cap papercut subjects                   list the subjects an entry can have"""

HEADER = """# Paper cuts

Friction in Captain itself: harness quirks, broken scripts, and skills that misfire.

Generated by `cap papercut` from `paper-cuts.jsonl`. Log with
`cap papercut add <subject> "<text>"`; remove fixed entries with
`cap papercut close <id>`.

A defect in a project Captain was working on is not a paper cut. It goes in
`notes/<project>/defects.md`, where the next task on that project will find it,
and `cap papercut` refuses a project as a subject.

A defect belongs here only while it is open.
"""


def subjects():
    bin_dir = os.path.join(caplib.HOME, "bin")
    names = {"lib", "lint", "config", "docs", "rules", "claude", "codex", "herdr"}

    for name in os.listdir(bin_dir):
        if name.startswith("cap-"):
            names.add(name[4:])
        elif name.startswith("lint-"):
            names.add("lint")

    hooks_dir = os.path.join(bin_dir, "hooks")
    for name in os.listdir(hooks_dir):
        names.add("hook/" + name.rsplit(".", 1)[0])

    skills_dir = os.path.join(caplib.HOME, ".claude", "skills")
    if os.path.isdir(skills_dir):
        for name in os.listdir(skills_dir):
            names.add("skill/" + name)

    return sorted(names)


def projects():
    path = os.path.join(caplib.HOME, "config", "projects.tsv")

    try:
        with open(path) as fh:
            names = {line.split("\t", 1)[0] for line in fh if line.strip()}
    except OSError:
        return set()

    return names - {"captain"}


def load():
    return list(caplib.read_jsonl(LEDGER))


@contextlib.contextmanager
def locked():
    path = os.path.join(caplib.HOME, "state", "paper-cuts.lock")
    os.makedirs(os.path.dirname(path), exist_ok=True)

    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def save(entries):
    ledger = "".join(
        json.dumps(entry, ensure_ascii=False) + "\n" for entry in entries
    )
    markdown = render(entries)

    for path, text in ((LEDGER, ledger), (MARKDOWN, markdown)):
        tmp = path + ".tmp"

        with open(tmp, "w") as fh:
            fh.write(text)

        os.replace(tmp, path)


def render(entries):
    lines = [HEADER]

    for entry in entries:
        first, *rest = entry["text"].split("\n")
        lines.append(
            f"- [ ] #{entry['id']} {entry['opened']} "
            f"`{entry['subject']}` - {first}"
        )

        for line in rest:
            lines.append("  " + line if line else "")

    return "\n".join(lines) + "\n"


def add(subject, text):
    if subject in projects():
        raise caplib.CapError(
            f"{subject} is a project, not part of Captain; "
            f"record it in notes/{subject}/defects.md"
        )

    if subject not in subjects():
        raise caplib.CapError(
            f"unknown subject '{subject}'; run cap papercut subjects"
        )

    if not text.strip():
        raise caplib.CapError("nothing to log")

    with locked():
        entries = load()
        entry = {
            "id": max((entry["id"] for entry in entries), default=0) + 1,
            "opened": time.strftime("%Y-%m-%d"),
            "subject": subject,
            "status": "open",
            "text": " ".join(text.split()),
        }
        save(entries + [entry])

    print(f"logged #{entry['id']}")


def close(ident):
    ident = ident.lstrip("#")

    with locked():
        entries = load()

        for index, entry in enumerate(entries):
            if str(entry["id"]) != ident:
                continue

            entries.pop(index)
            save(entries)
            print(f"removed #{entry['id']}")
            return

    raise caplib.CapError(f"no paper cut #{ident}")


def main():
    args = sys.argv[1:]

    if not args:
        sys.stdout.write(render(load()))
        return 0

    if args == ["subjects"]:
        print("\n".join(subjects()))
        return 0

    if len(args) == 3 and args[0] == "add":
        add(args[1], args[2])
        return 0

    if len(args) == 2 and args[0] == "close":
        close(args[1])
        return 0

    raise caplib.CapError(USAGE)


if __name__ == "__main__":
    caplib.run_main(main)
