#!/usr/bin/env python3
"""cap-launch - start a task agent session in a pane."""

import argparse
import os
import sys
import time
import uuid

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import caplib  # noqa: E402


def main():
    parser = argparse.ArgumentParser(prog="cap-launch")
    parser.add_argument("--task", required=True)
    parser.add_argument("--label", help="tab label; defaults to --task")
    parser.add_argument("--dir", required=True)
    parser.add_argument("--harness", required=True, choices=["claude", "codex"])
    parser.add_argument("--model", default="-")
    parser.add_argument("--effort", default="")
    parser.add_argument(
        "--guard",
        action="store_true",
        help="hold the agent to the task's owns list",
    )

    prompt_group = parser.add_mutually_exclusive_group(required=True)
    prompt_group.add_argument(
        "--prompt-file",
        help="read the opening prompt from a private file",
    )
    prompt_group.add_argument("prompt", nargs="?")

    args = parser.parse_args()

    if args.prompt_file:
        with open(args.prompt_file) as fh:
            prompt = fh.read()
    else:
        prompt = args.prompt

    caplib.task_lock(args.task)
    caplib.trust(args.harness, args.dir)

    turn_dir = os.path.join(caplib.TASKS, args.task, "turns")
    session_id = str(uuid.uuid4()) if args.harness == "claude" else None

    argv = caplib.session_argv(
        args.harness,
        args.model,
        args.effort,
        "" if args.prompt_file else prompt,
        session_id=session_id,
        guard_slug=args.task if args.guard else None,
    )

    session = caplib.launch(
        args.dir,
        args.label or args.task,
        argv,
        turn_dir,
        env={"CAP_TASK": args.task},
    )

    if args.prompt_file:
        # herdr can drop pane input while the TUI is still starting.
        time.sleep(0.8)
        caplib.pane_type(session.pane, prompt)

    print(f"{session.pane} {session.tab} {session_id or '-'}")
    return 0


caplib.run_main(main)
