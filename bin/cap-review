#!/usr/bin/env python3
"""cap-review - run gate reviewers and record their findings."""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import threading
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import caplib  # noqa: E402

PROMPT = """Read {rules}, then review every change in this worktree since {since}
(git diff {since}, plus the untracked files listed below). Do not edit files.

These are the files that changed:
{files}

Report concrete defects: what is wrong, where, and the failure it causes.
Say what you verified as working too, file by file.

End your final message with one fenced json block, exactly this shape:

```json
{{"findings": [{{"file": "path/from/repo/root", "line": 12, "severity": "blocker", "confidence": "confirmed", "claim": "what is wrong and the failure it causes"}}],
 "checked": [{{"file": "path/from/repo/root", "note": "what you verified in this file"}}]}}
```

severity is blocker, major or minor. line may be null when a defect has no
single line. confidence is confirmed or suspected. Use confirmed only when
the claim is established by source inspection or a check. Use suspected when
the needed command or environment is unavailable and the claim remains
uncertain. Every changed file above must appear in findings or in checked.
Captain computes the verdict from this block: a confirmed blocker or major
finding fails the gate. Suspected findings remain visible as advice. Do not
state a verdict yourself.
"""


def parse_args():
    parser = argparse.ArgumentParser(prog="cap-review")
    parser.add_argument("--slug", required=True)
    parser.add_argument("--tree", required=True)
    parser.add_argument("--since", required=True)
    parser.add_argument("--commit", required=True)
    parser.add_argument("--fingerprint", required=True)
    parser.add_argument("--out-dir", required=True)
    parser.add_argument("--results", required=True)
    parser.add_argument("--full", action="store_true")
    parser.add_argument("--reviewer", action="append", required=True)
    return parser.parse_args()


def changed_files(tree, since):
    def git_lines(*args):
        result = subprocess.run(
            ["git", "-C", tree, *args],
            stdout=subprocess.PIPE,
            text=True,
            check=True,
        )
        return [line for line in result.stdout.splitlines() if line]

    tracked = git_lines("diff", "--name-only", since)
    untracked = git_lines("ls-files", "--others", "--exclude-standard")
    return sorted(set(tracked) | set(untracked))


def file_hashes(tree, paths):
    hashes = {}

    for path in paths:
        full = os.path.join(tree, path)

        if not os.path.isfile(full):
            hashes[path] = "deleted"
            continue

        with open(full, "rb") as fh:
            hashes[path] = hashlib.sha256(fh.read()).hexdigest()

    return hashes


def write_manifest(args, state, reviewers):
    path = os.path.join(caplib.TASKS, args.slug, "review.json")
    record = {
        "state": state,
        "pid": os.getpid(),
        "fingerprint": args.fingerprint,
        "results": args.results,
        "reviewers": [label for label, _ in reviewers],
        "started": caplib.iso_now(),
    }

    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as fh:
        json.dump(record, fh)

    os.replace(tmp, path)


def parse_reviewer(spec):
    label, _, profile_spec = spec.partition("=")
    name, _, role = profile_spec.partition("@")

    if not label or not name:
        raise caplib.CapError(f"bad --reviewer {spec!r}; want LABEL=PROFILE@ROLE")

    harness, model, effort = caplib.lib("ask_profile", name).split()
    profile = caplib.Profile(name, harness, model, effort, role)
    return label, profile


def strip_block(text):
    matches = list(caplib.FENCE.finditer(text))
    if not matches:
        return text.strip()

    last = matches[-1]
    return (text[: last.start()] + text[last.end() :]).strip()


def render(slug, label, profile, args, report, answer):
    lines = [
        f"# Gate {label}: {slug}",
        "",
        f"{profile.name} reviewed the changes since {args.since[:12]}, "
        f"with HEAD at {args.commit[:12]} "
        f"(fingerprint {args.fingerprint[:12]}). "
        f"Verdict: {caplib.verdict(report)}.",
        "",
        "## Findings",
        "",
    ]

    findings = report.get("findings") or []
    if not findings:
        lines.append("None.")

    for finding in findings:
        if finding.get("line"):
            where = f"{finding['file']}:{finding['line']}"
        else:
            where = finding["file"]

        lines.append(
            f"- [{finding['severity']}, {finding['confidence']}] "
            f"`{where}` {finding['claim']} "
            f"(finding {caplib.finding_id(finding)})"
        )

    lines += ["", "## Checked", ""]

    for checked in report.get("checked") or []:
        lines.append(f"- `{checked['file']}`: {checked['note']}")

    prose = strip_block(answer)
    if prose:
        lines += ["", "## Reviewer's report", "", prose]

    return "\n".join(lines) + "\n"


MISSING_COVERAGE = "these changed files are in neither findings nor checked:"


def merge_reports(base, addition):
    merged = {
        "findings": list(base.get("findings") or []),
        "checked": list(base.get("checked") or []),
    }

    for key in ("findings", "checked"):
        for item in addition.get(key) or []:
            path = item.get("file")
            for other in ("findings", "checked"):
                merged[other] = [
                    existing
                    for existing in merged[other]
                    if existing.get("file") != path
                ]
            merged[key].append(item)

    return merged


class ReviewReport:
    """Keep a valid report while a reviewer fills missing file coverage."""

    def __init__(self, changed, tree):
        self.changed = changed
        self.tree = tree
        self.report = None
        self.additive = False

    @staticmethod
    def only_missing_coverage(problems):
        return bool(problems) and all(
            problem.startswith(MISSING_COVERAGE) for problem in problems
        )

    def validate(self, text):
        report, error = caplib.findings_block(text)
        if error:
            self.additive = False
            return [error]

        if self.report is None or not self.additive:
            problems = caplib.validate_findings(report, self.changed, self.tree)
            self.report = (
                report
                if not problems or self.only_missing_coverage(problems)
                else None
            )
            self.additive = self.only_missing_coverage(problems)
            return problems

        addition_problems = caplib.validate_findings(
            report,
            self.changed,
            self.tree,
        )
        if any(
            not problem.startswith(MISSING_COVERAGE)
            for problem in addition_problems
        ):
            self.additive = False
            return addition_problems

        self.report = merge_reports(self.report, report)
        problems = caplib.validate_findings(self.report, self.changed, self.tree)
        self.additive = bool(problems)
        return problems

    def repair_prompt(self, problems):
        if not self.additive or self.report is None:
            return caplib.correction(problems)

        covered = {
            item.get("file")
            for key in ("findings", "checked")
            for item in self.report.get(key) or []
        }
        missing = [path for path in self.changed if path not in covered]
        return (
            "Keep the valid report entries from your previous answer. Return "
            "exactly one fenced json block with findings and checked entries "
            "only for these omitted files:\n"
            + "\n".join(f"- {path}" for path in missing)
            + "\nDo not repeat files already covered."
        )

    def answer_text(self, text):
        if self.report is None:
            return text

        prose = strip_block(text)
        block = json.dumps(self.report, ensure_ascii=False)
        if prose:
            return f"{prose}\n\n```json\n{block}\n```"
        return f"```json\n{block}\n```"


def save_review(slug, label, profile, args, answer, report, hashes):
    verdict = caplib.verdict(report)
    findings = [
        dict(finding, id=caplib.finding_id(finding))
        for finding in report["findings"]
    ]

    record = {
        "at": caplib.iso_now(),
        "label": label,
        "profile": profile.name,
        "session": answer.session_id,
        "since": args.since,
        "commit": args.commit,
        "fingerprint": args.fingerprint,
        "full": args.full,
        "verdict": verdict,
        "findings": findings,
        "checked": report["checked"],
        "files": hashes,
    }

    findings_path = os.path.join(caplib.TASKS, slug, "findings.jsonl")
    with open(findings_path, "a") as fh:
        fh.write(json.dumps(record) + "\n")

    report_path = os.path.join(args.out_dir, f"{slug}.gate-{label}.md")
    with open(report_path, "w") as fh:
        fh.write(render(slug, label, profile, args, report, answer.text))

    return verdict, report_path


def review(slug, label, profile, args, prompt, changed, hashes, results, lock):
    started = time.time()
    tree = os.path.realpath(args.tree)

    def validate(text):
        return review_report.validate(text)

    review_report = ReviewReport(changed, tree)
    result = {
        "label": label,
        "profile": profile.name,
        "verdict": None,
    }

    try:
        answer = caplib.ask(
            profile,
            prompt,
            tree,
            label=f"gate-{label}-{slug}",
            validate=validate,
            repair_prompt=review_report.repair_prompt,
            guard_slug=args.guard,
            # A correction round costs the model nothing it doesn't already have:
            # the conversation keeps its findings, and a round only has to resend
            # the list with the named gaps filled. On a diff wide enough to need
            # a few hundred "checked" entries, the default budget of 2 rounds
            # regularly runs out while still finding one or a handful of files
            # unaccounted for, forcing a whole fresh review rather than one more
            # cheap correction.
            repairs=5,
        )
        answer = caplib.Answer(
            review_report.answer_text(answer.text),
            answer.session_id,
        )
        report, _ = caplib.findings_block(answer.text)

        with lock:
            verdict, report_path = save_review(
                slug,
                label,
                profile,
                args,
                answer,
                report,
                hashes,
            )

        result["verdict"] = verdict
        elapsed = int(time.time() - started)

        lines = [
            f"gate {label} ({profile.name}): {verdict} in {elapsed}s, "
            f"report {report_path}"
        ]

        for finding in report["findings"]:
            lines.append(
                f"  [{finding['severity']}] "
                f"{finding['file']}:{finding.get('line') or '-'} "
                f"{finding['claim']} ({caplib.finding_id(finding)})"
            )

    except caplib.CapError as error:
        result["error"] = str(error)
        elapsed = int(time.time() - started)
        lines = [
            f"gate {label} ({profile.name}): "
            f"no result after {elapsed}s: {error}"
        ]

    with lock:
        results[label] = result
        print("\n".join(lines), flush=True)


def main():
    args = parse_args()

    caplib.task_lock(args.slug)

    owns = os.path.join(caplib.TASKS, args.slug, "owns")
    args.guard = args.slug if os.path.isfile(owns) else None

    reviewers = [parse_reviewer(spec) for spec in args.reviewer]
    for _, profile in reviewers:
        caplib.check_profile(profile)

    changed = changed_files(args.tree, args.since)
    hashes = file_hashes(args.tree, changed)

    prompt = PROMPT.format(
        rules=os.path.join(caplib.HOME, "rules", "code.md"),
        since=args.since,
        files="\n".join(f"  {path}" for path in changed),
    )

    tree = os.path.realpath(args.tree)

    # Trust updates shared state, so finish them before reviewer threads start.
    harnesses = sorted({profile.harness for _, profile in reviewers})
    for harness in harnesses:
        caplib.trust(harness, tree)

    write_manifest(args, "running", reviewers)

    results = {}
    lock = threading.Lock()
    threads = []

    for label, profile in reviewers:
        thread = threading.Thread(
            target=review,
            args=(
                args.slug,
                label,
                profile,
                args,
                prompt,
                changed,
                hashes,
                results,
                lock,
            ),
        )
        thread.start()
        threads.append(thread)

    for thread in threads:
        thread.join()

    with open(args.results, "w") as fh:
        for label, _ in reviewers:
            fh.write(json.dumps(results[label]) + "\n")

    write_manifest(args, "complete", reviewers)
    return 0


caplib.run_main(main)
