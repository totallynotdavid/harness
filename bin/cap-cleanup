#!/usr/bin/env bash
# cap-cleanup - clean up comments and readability with a separate model.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

slug=${1:?usage: cap cleanup <slug> [profile]}
profile=${2:-@chore}

task_load "$slug"
task_lock "$slug"

[ "$(git_dirty "$CAP_TREE")" != 0 ] || die "$slug's worktree is clean; nothing to clean up"

# Say "tracked and untracked" rather than "changed". A cleanup pass on
# local-env read only the tracked diff and skipped .devstack/ entirely, which
# was seventeen new files and the bulk of the change, then reported itself
# done. A task whose deliverable is a new directory is the normal case, not
# the exception.
prompt="Read $CAP_HOME/rules/comments.md and the Readability section of
$CAP_HOME/rules/code.md, then apply them to every file this worktree changes
against $CAP_BASE. That means both the tracked diff and every untracked file
git status reports. New files are usually where most of the change is.

Only clean up comments and readability. Remove comments that repeat the code.
Shorten comments that stay. Rename only misleading names. Remove obvious dead
code. Do not change behavior, run tests, or commit. Leave all edits unstaged.

If a section does not need changes, leave it alone."

"$CAP_HOME/bin/cap-ask" "$profile" "$prompt" --dir "$CAP_TREE"

# Record what this pass saw. cap land refuses to deliver content that no
# cleanup pass has read, so rules/comments.md gets applied to every task
# instead of only the ones the captain remembers to clean.
printf '%s\n' "$(tree_content_hash "$CAP_TREE" "$CAP_BASE")" >"$TASKS/$slug/cleaned"
