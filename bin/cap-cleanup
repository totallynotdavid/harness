#!/usr/bin/env bash
# cap-cleanup - clean up comments and readability with a separate model.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

slug=${1:?usage: cap cleanup <slug> [profile]}
profile=${2:-@chore}

task_load "$slug"
task_lock "$slug"

# Refuse on a worktree with nothing to review, not on one with nothing
# uncommitted. The prompt below works against $CAP_BASE, which is well defined
# after cap commit too, and requiring a dirty tree meant a cleanup pass could
# only ever run before the commit. cap check reports over-long comment blocks
# on committed work, and the pass that fixes them has to be reachable then.
base=$(diff_base "$CAP_TREE" "$CAP_BASE")
reviewable=$(git -C "$CAP_TREE" diff --name-only "$base" | wc -l)
reviewable=$((reviewable + $(git -C "$CAP_TREE" ls-files --others --exclude-standard | wc -l)))
reviewable=$((reviewable + $(git -C "$CAP_TREE" diff --name-only | wc -l)))
[ "$reviewable" != 0 ] || die "$slug's worktree has no changes against $CAP_BASE; nothing to clean up"

# Name the commands, and specifically never git status. Two cleanup passes have
# now skipped local-env's .devstack/, which is seventeen files and the bulk of
# that task's change, because `git status --porcelain` collapses an untracked
# directory into the single line `?? .devstack/`. The pass was reading the
# command it was given and the command was hiding the files. ls-files lists
# them, which is why cap check has always used it. A third pass on a committed
# worktree found the tree clean and stopped, so the diff is named against the
# merge base rather than left to the reader.
prompt="Read $CAP_HOME/rules/comments.md and the Readability section of
$CAP_HOME/rules/code.md, then apply them to every file this worktree changes
against $CAP_BASE.

Those files are what these two commands list together. Run both:

  git diff --name-only $base
  git ls-files --others --exclude-standard

Do not use git status to find them. It collapses an untracked directory into a
single entry, so a task that delivers a new directory looks like one file. And
a clean tree does not mean there is nothing to review, because the work is
usually committed on this branch already.

Only clean up comments and readability. Remove comments that repeat the code.
Shorten comments that stay. Rename only misleading names. Remove obvious dead
code. Do not change behavior, run tests, or commit. Leave all edits unstaged.

If a section does not need changes, leave it alone."

exec "$CAP_HOME/bin/cap-ask" "$profile" "$prompt" --dir "$CAP_TREE"
