#!/usr/bin/env bash
# cap-cleanup - clean up comments and readability with a separate model.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: cap cleanup <slug> [profile] [--take]"

take=0
slug=""
profile=""

while [ $# -gt 0 ]; do
  case $1 in
  --take)
    take=1
    shift
    ;;
  -*)
    die "$usage"
    ;;
  *)
    if [ -z "$slug" ]; then
      slug=$1
    elif [ -z "$profile" ]; then
      profile=$1
    else
      die "$usage"
    fi
    shift
    ;;
  esac
done

[ -n "$slug" ] || die "$usage"
profile=${profile:-@chore}

task_load "$slug"
task_lock "$slug"

if [ "$take" = 1 ]; then
  task_owner_take "$slug"
else
  task_owner_claim "$slug"
fi

base=$(diff_base "$CAP_TREE" "$CAP_BASE")

reviewable=$(git -C "$CAP_TREE" diff --name-only "$base" | wc -l)
reviewable=$((reviewable + $(git -C "$CAP_TREE" ls-files --others --exclude-standard | wc -l)))

[ "$reviewable" != 0 ] ||
  die "$slug's worktree has no changes against $CAP_BASE; nothing to clean up"

prompt="Read $CAP_HOME/rules/comments.md and the Readability section of
$CAP_HOME/rules/code.md, then apply them to every file this worktree changes
against $CAP_BASE.

Find those files by running both commands:

  git diff --name-only $base
  git ls-files --others --exclude-standard

Do not use git status. It can collapse an untracked directory into one entry,
and committed work on this branch still needs review even when the worktree is
clean.

Only clean up comments and readability. Remove comments that repeat the code.
Shorten comments that stay. Rename only misleading names. Remove obvious dead
code. Do not change behavior, run tests, or commit. Leave all edits unstaged.

If a section does not need changes, leave it alone."

# exec would discard task_lock's EXIT trap and leave queued messages unflushed.
"$CAP_BIN/cap-ask" "$profile" "$prompt" --dir "$CAP_TREE" --label "cleanup-$slug"

step_record "$slug" cleanup "done"
