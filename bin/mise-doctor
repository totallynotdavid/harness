#!/usr/bin/env bash
# mise-doctor - verify mise and this repository's setup.
set -euo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'mise-doctor: run this task inside a Git checkout\n' >&2
  exit 1
}

config=$root/mise.toml
failed=0

problem() {
  printf 'mise-doctor: %s\n' "$*" >&2
  failed=1
}

check_setup() {
  mise -C "$root" doctor ||
    problem "mise doctor reported a failure"

  if [ ! -f "$config" ]; then
    problem "missing $config"
  elif ! mise -C "$root" config ls --json | grep -Fq "\"path\": \"$config\""; then
    problem "$config is not an active mise configuration"
  fi

  trust=$(mise -C "$root" trust --show)
  trust_status=$(printf '%s\n' "$trust" | grep -m1 'trusted' || true)
  printf 'mise config trust: %s\n' "${trust_status:-implicit or unknown}"

  missing=$(mise -C "$root" ls --current --missing --no-header)
  if [ -n "$(printf '%s' "$missing" | tr -d '[:space:]')" ]; then
    problem "project tools are missing:
$missing"
  fi

  mise -C "$root" tasks validate ||
    problem "mise task validation failed"

  tasks=$(mise -C "$root" tasks ls --local --name-only)
  for task in check lint doctor test; do
    if ! printf '%s\n' "$tasks" | grep -Fxq "$task"; then
      problem "missing repository task: $task"
    fi
  done
}

main() {
  if ! command -v mise >/dev/null 2>&1; then
    problem "mise is not on PATH"
  else
    check_setup
  fi

  if [ "$failed" -ne 0 ]; then
    return 1
  fi

  printf 'mise-doctor: repository setup is ready\n'
}

main
