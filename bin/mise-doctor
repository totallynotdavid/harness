#!/usr/bin/env bash
# mise-doctor - verify mise and this repository's setup.
set -euo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'mise-doctor: run this task inside a Git checkout\n' >&2
  exit 1
}
config=$root/mise.toml
failed=0

problem() {
  printf 'mise-doctor: %s\n' "$*" >&2
  failed=1
}

command -v mise >/dev/null 2>&1 || problem "mise is not on PATH"
if [ "$failed" -eq 0 ]; then
  mise -C "$root" doctor || problem "mise doctor reported a failure"

  [ -f "$config" ] || problem "missing $config"
  if [ -f "$config" ]; then
    if ! mise -C "$root" config ls --json | grep -Fq "\"path\": \"$config\""; then
      problem "$config is not an active mise configuration"
    fi
  fi

  trust=$(mise -C "$root" trust --show)
  printf 'mise config trust: %s\n' "$(printf '%s\n' "$trust" | grep -m1 'trusted' || printf 'implicit or unknown')"

  missing=$(mise -C "$root" ls --current --missing --no-header)
  if [ -n "$(printf '%s' "$missing" | tr -d '[:space:]')" ]; then
    problem "project tools are missing:\n$missing"
  fi

  mise -C "$root" tasks validate || problem "mise task validation failed"
  tasks=$(mise -C "$root" tasks ls --local --name-only)
  for task in check lint doctor test; do
    printf '%s\n' "$tasks" | grep -Fxq "$task" || problem "missing repository task: $task"
  done
fi

if [ "$failed" -ne 0 ]; then
  exit 1
fi
printf 'mise-doctor: repository setup is ready\n'
