#!/usr/bin/env bash
# cap-budget - show what Captain can dispatch right now, and why.
#
# Sizing happens silently inside cap spawn, cap gate and cap ask. This is where
# a captain looks when the answer surprises them.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

# One line per harness that any tier actually reaches for. A harness with no
# reading is reported as unmeasured rather than left out, because "Captain is
# not watching this account at all" is the thing a captain most needs told.
harnesses=$(
  for tier in heavy standard cheap; do
    for profile in $(tier_peers "$tier"); do
      ask_profile "$profile" 2>/dev/null | awk '{print $1}'
    done
  done | sort -u
)

for h in $harnesses; do
  read -r pct resets src <<<"$(usage_read "$h")"
  if [ "$src" = none ]; then
    printf '%-8s unmeasured  (no reading in the last %ss; nothing is held back)\n' "$h" "${CAP_USAGE_TTL:-900}"
    continue
  fi
  printf '%-8s %s%%  (%s)\n' "$h" "$pct" "$(usage_detail "$h" "$src")"
  if [ "$resets" -gt "$(now)" ] 2>/dev/null; then
    printf '%-8s window resets at %s\n' "" "$(date -d "@$resets" '+%H:%M')"
  fi
done

blocked=""
for f in "$CAP_BLOCK_DIR"/*; do
  [ -f "$f" ] || continue
  p=$(basename "$f")
  if profile_blocked "$p"; then
    blocked="${blocked:+$blocked }$p(until $(date -d "@$(profile_block_until "$p")" '+%H:%M'))"
  fi
done
printf 'rate limited %s\n' "${blocked:-none}"

printf '\n%-9s %-9s %-8s %-4s %s\n' ROLE TIER DISPATCH ADMIT PEERS
for role in crew scout gate-a gate-b chore; do
  tier=$(role_tier "$role")
  printf '%-9s %-9s %-8s %-4s %s\n' \
    "$role" "$tier" "$(role_profile "$role" || printf -- '-')" \
    "$(tier_admit "$tier")" "$(tier_peers "$tier")"
done

if [ -s "$CAP_DISPATCH_LOG" ]; then
  printf '\nrecent decisions (%s)\n' "$CAP_DISPATCH_LOG"
  # Skip cap-budget's own probes. Asking what would be dispatched is not a
  # dispatch, and it would otherwise push the real ones out of view.
  grep -v $'\tcap-budget\t' "$CAP_DISPATCH_LOG" | tail -n 8 | awk -F'\t' '{printf "  %s  %-11s %-8s -> %-7s %s at %s%%\n", $1, $2, $3, $4, $5, $6}'
fi
