#!/usr/bin/env bash
# cap-budget - show what Captain can dispatch right now, and why.
#
# Sizing happens silently inside cap spawn, cap gate and cap ask. This is where
# a captain looks when the answer surprises them.
. "$(dirname "$(readlink -f "$0")")/lib.sh"

read -r pct resets src <<<"$(usage_read)"

if [ "$src" = none ]; then
  printf 'utilization  unmeasured (no reading in the last %ss; nothing is held back)\n' "${CAP_USAGE_TTL:-900}"
else
  detail=""
  if usage_files; then
    detail=$(jq -rs '
      map(select(.at != null)) | if length == 0 then "" else
        (max_by(.at)
         | "5h \(.five_hour.pct // 0 | floor)%, 7d \(.seven_day.pct // 0 | floor)%, read \(now - .at | floor)s ago")
      end' "$CAP_USAGE_DIR"/*.json 2>/dev/null) || detail=""
  fi
  [ "$src" != cache ] || detail="from the harness cache in ~/.claude.json"
  printf 'utilization  %s%%  (%s)\n' "$pct" "$detail"
  if [ "$resets" -gt "$(now)" ] 2>/dev/null; then
    printf 'resets       %s\n' "$(date -d "@$resets" '+%H:%M')"
  fi
fi

case ${CAP_CEILING:-auto} in
  none) printf 'ceiling      none\n' ;;
  auto)
    m=$(captain_model)
    if [ -n "$m" ]; then
      # Name the rung rather than its rank. The rank is an implementation
      # detail; the profile is the thing a captain would pin by hand.
      top=$(printf '%s\n' "${CAP_PROFILE_RANK:-}" | tr ' ' '\n' |
        awk -F: -v c="$(ceiling_rank)" '$2==c {print $1; exit}')
      printf 'ceiling      %s (auto: this session is running %s)\n' "${top:-none}" "$m"
    else
      printf 'ceiling      none (auto, but no status line reading from %s yet)\n' "$CAP_HOME"
    fi
    ;;
  *) printf 'ceiling      %s (pinned)\n' "$CAP_CEILING" ;;
esac

blocked=""
for f in "$CAP_BLOCK_DIR"/*; do
  [ -f "$f" ] || continue
  p=$(basename "$f")
  if profile_blocked "$p"; then
    blocked="${blocked:+$blocked }$p(until $(date -d "@$(profile_block_until "$p")" '+%H:%M'))"
  fi
done
printf 'rate limited %s\n' "${blocked:-none}"

printf '\n%-9s %-10s %s\n' ROLE DISPATCHES LADDER
for role in crew scout gate-a gate-b chore; do
  printf '%-9s %-10s %s\n' "$role" "$(role_profile "$role" || printf -- '-')" "$(role_ladder "$role")"
done
