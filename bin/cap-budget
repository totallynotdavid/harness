#!/usr/bin/env bash
# cap-budget - show current dispatch capacity and recent sizing decisions.

. "$(dirname "$(readlink -f "$0")")/lib.sh"

harnesses=$(
  for tier in heavy standard cheap; do
    for profile in $(tier_peers "$tier"); do
      ask_profile "$profile" 2>/dev/null | awk '{print $1}'
    done
  done | sort -u
)

for harness in $harnesses; do
  read -r percent resets source <<<"$(usage_read "$harness")"

  if [ "$source" = none ]; then
    printf \
      '%-8s unmeasured  (no reading in the last %ss; nothing is held back)\n' \
      "$harness" \
      "${CAP_USAGE_TTL:-900}"
    continue
  fi

  printf \
    '%-8s %s%%  (%s)\n' \
    "$harness" \
    "$percent" \
    "$(usage_detail "$harness" "$source")"

  if [ "$resets" -gt "$(now)" ] 2>/dev/null; then
    printf \
      '%-8s window resets at %s\n' \
      "" \
      "$(date -d "@$resets" '+%H:%M')"
  fi
done

blocked=""

for path in "$CAP_BLOCK_DIR"/*; do
  [ -f "$path" ] || continue

  profile=$(basename "$path")
  if profile_blocked "$profile"; then
    blocked="${blocked:+$blocked }$profile(until $(date -d "@$(profile_block_until "$profile")" '+%H:%M'))"
  fi
done

printf 'rate limited %s\n' "${blocked:-none}"

printf '\n%-9s %-9s %-8s %-7s %-4s %s\n' \
  ROLE TIER DISPATCH EFFORT ADMIT PEERS

for role in crew scout gate-a gate-b chore; do
  tier=$(role_tier "$role")
  profile=$(role_profile "$role" || printf -- '-')
  effort=$(role_effort "$role" | grep . || printf -- '-')

  printf '%-9s %-9s %-8s %-7s %-4s %s\n' \
    "$role" \
    "$tier" \
    "$profile" \
    "$effort" \
    "$(tier_admit "$tier")" \
    "$(tier_peers "$tier")"
done

if [ -s "$CAP_DISPATCH_LOG" ]; then
  printf '\nrecent decisions (%s)\n' "$CAP_DISPATCH_LOG"

  # cap-budget probes sizing without dispatching, so exclude its own entries.
  jq -r '
    select(.kind == "size" and .caller != "cap-budget")
    | "  \(.at)  \(.caller | .[0:11] | . + (" " * (11 - length)))  \(.role) -> \(.profile) (\(.harness) at \(.pct)%)"
  ' "$CAP_DISPATCH_LOG" 2>/dev/null | tail -n 8 || true

  # Token counts are per session. The 5h usage window includes the whole account.
  printf '\nrecent dispatch cost (tokens exact; 5h window is account-wide)\n'
  jq -r '
    select(.kind == "cost")
    | "  \(.at)  \(.label)  \(.profile)  \(.seconds)s  in \(.tokens.input) out \(.tokens.output) cache \(.tokens.cache_read)+\(.tokens.cache_creation)  5h \(.window_5h_account_wide.start // "?")% -> \(.window_5h_account_wide.end // "?")%"
  ' "$CAP_DISPATCH_LOG" 2>/dev/null | tail -n 8 || true
fi
