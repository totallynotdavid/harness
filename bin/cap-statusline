#!/usr/bin/env python3
"""Render Claude's status line and record its quota reading."""

import json
import math
import os
import sys
import time


CAP_HOME = os.environ.get("CAP_HOME") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__))
)


def field(payload, *path):
    value = payload

    for key in path:
        if not isinstance(value, dict):
            return None
        value = value.get(key)

    return value


def round_percent(value):
    if not isinstance(value, (int, float)):
        return None

    # Claude reports fractional percentages; Captain displays whole percentages.
    return math.floor(value + 0.5)


def rate_window(payload, name):
    window = field(payload, "rate_limits", name)
    if not isinstance(window, dict):
        return None

    return {
        "pct": round_percent(window.get("used_percentage")),
        "resets_at": window.get("resets_at"),
    }


def render_status(payload):
    parts = []

    model = field(payload, "model", "display_name")
    if model:
        parts.append(str(model))

    used = field(payload, "context_window", "used_percentage")
    remaining = field(payload, "context_window", "remaining_percentage")
    if used is not None and remaining is not None:
        parts.append(f"ctx {used:.0f}% used  {remaining:.0f}% left")

    input_tokens = field(payload, "context_window", "total_input_tokens")
    output_tokens = field(payload, "context_window", "total_output_tokens")
    if input_tokens is not None and output_tokens is not None:
        parts.append(f"in:{input_tokens} out:{output_tokens}")

    rates = []
    for label, name in (("5h", "five_hour"), ("7d", "seven_day")):
        window = rate_window(payload, name)
        if window and window["pct"] is not None:
            rates.append(f"{label}:{window['pct']:.0f}%")

    if rates:
        parts.append(" ".join(rates))

    return "  |  ".join(parts)


def usage_snapshot(payload):
    session = field(payload, "session_id") or "unknown"

    return {
        "at": int(time.time()),
        "session_id": session,
        # Usage readers use this to separate account readings by harness.
        "harness": "claude",
        "model_id": field(payload, "model", "id") or "",
        "model": field(payload, "model", "display_name") or "",
        "cwd": field(payload, "workspace", "current_dir")
        or field(payload, "cwd")
        or "",
        "project_dir": field(payload, "workspace", "project_dir") or "",
        "five_hour": rate_window(payload, "five_hour"),
        "seven_day": rate_window(payload, "seven_day"),
        "spend_limit": rate_window(payload, "spend_limit"),
        # cap ask uses this to decide whether a stopped session can resume.
        "ctx_pct": round_percent(
            field(payload, "context_window", "used_percentage")
        ),
    }


def read_snapshot(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def snapshot_changed(previous, snapshot):
    if previous is None:
        return True

    fields = ("five_hour", "seven_day", "spend_limit", "model_id", "ctx_pct")
    return any(previous.get(key) != snapshot[key] for key in fields)


def write_snapshot(path, snapshot):
    temporary = path + ".tmp"

    with open(temporary, "w") as fh:
        json.dump(snapshot, fh)

    os.replace(temporary, path)


def remove_old_snapshots(usage_dir, now):
    cutoff = now - 86400

    for name in os.listdir(usage_dir):
        if not name.endswith(".json"):
            continue

        path = os.path.join(usage_dir, name)

        try:
            if os.path.getmtime(path) < cutoff:
                os.remove(path)
        except OSError:
            pass


def save_usage(payload):
    try:
        snapshot = usage_snapshot(payload)

        usage_dir = os.path.join(CAP_HOME, "state", "usage")
        os.makedirs(usage_dir, exist_ok=True)

        path = os.path.join(usage_dir, snapshot["session_id"] + ".json")
        previous = read_snapshot(path)

        if not snapshot_changed(previous, snapshot):
            age = snapshot["at"] - int(previous.get("at", 0))
            if age < 20:
                return

        write_snapshot(path, snapshot)
        remove_old_snapshots(usage_dir, snapshot["at"])
    except Exception:
        # Status recording must never break Claude's status line.
        pass


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    sys.stdout.write(render_status(payload))
    save_usage(payload)
    return 0


raise SystemExit(main())
