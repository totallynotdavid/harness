#!/usr/bin/env bash
# lint-comments - enforce current-contract comments.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/../.."

files=(bin/cap bin/cap-* bin/lib.sh bin/lib/*.sh bin/hooks/*.sh)
pattern='^[[:space:]]*#.*(used to|previously|no longer|before this|originally|was (failing|timing|broken)|had to be done|left over|historical|incident)'
matches=$(grep -nE -i "$pattern" "${files[@]}" || true)

if [ -n "$matches" ]; then
	printf '%s\n' "$matches" >&2
	exit 1
fi

printf 'lint-comments: source comments state current contracts\n'
